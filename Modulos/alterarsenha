#!/bin/bash
_w=$(tput cols 2>/dev/null); [[ "$_w" =~ ^[0-9]+$ ]] || _w=40; (( _w > 60 )) && _w=60; (( _w < 20 )) && _w=20; barra="\033[38;5;177m$(printf '─%.0s' $(seq 1 $_w))\033[0m"
echo -e "\E[48;5;162;1;38;5;231m ⚡ หลวงพี่ · AUTOSCRIPT\E[K\E[0m"
echo -e "$barra"
echo -e "\033[0m"
echo -e "\033[1;38;5;227mรายชื่อผู้ใช้งาน: \033[0m"
echo""
_userT=$(awk -F: '$3>=1000 {print $1}' /etc/passwd | grep -v nobody)
i=0
unset _userPass
while read _user; do
	i=$(expr $i + 1)
	_oP=$i
	[[ $i == [1-9] ]] && i=0$i && oP+=" 0$i"
	if [[ -e "/etc/AutoScript/senha/$_user" ]]; then
		_senha="$(cat /etc/AutoScript/senha/$_user)"
	else
		_senha='Null'
	fi
	suser=$(echo -e "\E[48;5;45;38;5;16m $i \E[0m \033[1;38;5;231m- \033[1;38;5;82m$_user\033[0m")
    ssenha=$(echo -e "\033[1;38;5;227mPassword\033[1;38;5;231m: $_senha")
    printf '%-60s%s\n' "$suser" "$ssenha"
	_userPass+="\n${_oP}:${_user}"
done <<< "${_userT}"
num_user=$(awk -F: '$3>=1000 {print $1}' /etc/passwd | grep -v nobody | wc -l)
echo ""
echo -ne "\033[1;38;5;82mUsername \033[1;38;5;227m[\033[1;38;5;51m1\033[1;38;5;203m-\033[1;38;5;51m$num_user\033[1;38;5;227m]\033[1;38;5;231m: " ; read option
user=$(echo -e "${_userPass}" | grep -E "\b$option\b" | cut -d: -f2)
if [[ -z $option ]]
then
	tput setaf 7 ; tput setab 0 ; tput bold ; echo "" ; echo "ไม่พบข้อมูลที่กรอก!" ; echo "" ; tput sgr0
	exit 1
elif [[ -z $user ]]
then
	tput setaf 7 ; tput setab 0 ; tput bold ; echo "" ; echo "ไม่พบข้อมูลที่กรอก!" ; echo "" ; tput sgr0
	exit 1
else
	if [[ `grep -c /$user: /etc/passwd` -ne 0 ]]
	then
		echo -ne "\n\033[1;38;5;82mNew Password \033[1;38;5;227m$user\033[1;38;5;231m: "; read password
		sizepass=$(echo ${#password})
		if [[ $sizepass -lt 1 ]]
		then
			tput setaf 7 ; tput setab 0 ; tput bold ; echo "" ; echo "รหัสผ่านต้องมีมากกว่า 1 ตัว   " ; echo "" ; tput sgr0
			exit 1
		else
			ps x | grep $user | grep -v grep | grep -v pt > /tmp/rem
			if [[ `grep -c $user /tmp/rem` -eq 0 ]]
			then
				echo "$user:$password" | chpasswd
				tput setaf 7 ; tput setab 0 ; tput bold ; echo "" ; echo "รหัสผ่านของผู้ใช้งาน $user เปลี่ยนเป็น: $password" ; echo "" ; tput sgr0
				echo "$password" > /etc/AutoScript/senha/$user
				exit 1
			else
				echo ""
				tput setaf 7 ; tput setab 0 ; tput bold ; echo "ผู้ใช้งานถูกตัดการเชื่อมต่อ..." ; tput sgr0
				pkill -f $user
				echo "$user:$password" | chpasswd
				tput setaf 7 ; tput setab 0 ; tput bold ; echo "" ; echo "รหัสผ่านของผู้ใช้งาน $user เปลี่ยนเป็น: $password" ; echo "" ; tput sgr0
				echo "$password" > /etc/AutoScript/senha/$user
				exit 1
			fi
		fi
	else
		tput setaf 7 ; tput setab 0 ; tput bold ; echo "" ; echo "ผู้ใช้งาน $user ไม่พบ!" ; echo "" ; tput sgr0
	fi
fi