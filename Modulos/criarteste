#!/bin/bash
_w=$(tput cols 2>/dev/null); [[ "$_w" =~ ^[0-9]+$ ]] || _w=40; (( _w > 60 )) && _w=60; (( _w < 20 )) && _w=20; barra="\033[38;5;177m$(printf '─%.0s' $(seq 1 $_w))\033[0m"
IP=$(cat /etc/IP)
if [ ! -d /etc/AutoScript/userteste ]; then
mkdir /etc/AutoScript/userteste
fi
echo -e "\E[48;5;162;1;38;5;231m ⚡ หลวงพี่ · AUTOSCRIPT\E[K\E[0m"
echo -e "$barra"
echo -e "\033[0m"
[ "$(ls -A /etc/AutoScript/userteste)" ] && echo -e "\033[1;38;5;82mบัญชีที่เปิดใช้งานอยู่ !   \033[1;38;5;231m" || echo -e "\033[1;38;5;203mไม่พบบัญชีที่เปิดทดสอบในขณะนี้ !   \033[0m"
for testeson in $(ls /etc/AutoScript/userteste |sort |sed 's/.sh//g')
do
echo "- $testeson"
done
echo ""
echo -ne "\033[1;38;5;82mชื่อผู้ใช้\033[1;38;5;231m: "; read nome
if [[ -z $nome ]]
then
echo ""
tput setaf 7 ; tput setab 0 ; tput bold ; echo "" ; echo "ชื่อว่างเปล่าหรือไม่ถูกต้อง    " ; echo "" ; tput sgr0
	exit 1
fi
awk -F : ' { print $1 }' /etc/passwd > /tmp/users 
if grep -Fxq "$nome" /tmp/users
then
	tput setaf 7 ; tput setab 0 ; tput bold ; echo "" ; echo "มีผู้ใช้งานรายนี้อยู่แล้ว    " ; echo "" ; tput sgr0
	exit 1
fi
echo -ne "\033[1;38;5;82mรหัสผ่าน\033[1;38;5;231m: "; read pass
if [[ -z $pass ]]
then
echo ""
tput setaf 7 ; tput setab 0 ; tput bold ; echo "" ; echo "รหัสผ่านว่างเปล่าหรือไม่ถูกต้อง    " ; echo "" ; tput sgr0
	exit 1
fi
echo -ne "\033[1;38;5;82mจำกัด\033[1;38;5;231m: "; read limit
if [[ -z $limit ]]
then
echo ""
tput setaf 7 ; tput setab 0 ; tput bold ; echo "" ; echo "จำกัดเชื่อมต่อว่างเปล่าหรือไม่ถูกต้อง    " ; echo "" ; tput sgr0
	exit 1
fi
echo -ne "\033[1;38;5;82mเวลา \033[1;38;5;227m(\033[1;38;5;203mเช่น:\033[1;38;5;231m60\033[1;38;5;227m)\033[1;38;5;231m: "; read u_temp
if [[ -z $limit ]]
then
echo ""
tput setaf 7 ; tput setab 0 ; tput bold ; echo "" ; echo "จำกัดเชื่อมต่อว่างเปล่าหรือไม่ถูกต้อง    " ; echo "" ; tput sgr0
	exit 1
fi
useradd -M -s /bin/false $nome
(echo $pass;echo $pass) |passwd $nome > /dev/null 2>&1
echo "$pass" > /etc/AutoScript/senha/$nome
echo "$nome $limit" >> /root/username.db
echo "#!/bin/bash
pkill -f "$nome"
userdel --force $nome
grep -v ^$nome[[:space:]] /root/username.db > /tmp/ph ; cat /tmp/ph > /root/username.db
rm /etc/AutoScript/senha/$nome > /dev/null 2>&1
rm -rf /etc/AutoScript/userteste/$nome.sh
exit" > /etc/AutoScript/userteste/$nome.sh
chmod +x /etc/AutoScript/userteste/$nome.sh
at -f /etc/AutoScript/userteste/$nome.sh now + $u_temp min > /dev/null 2>&1
clear
echo -e "\E[48;5;162;1;38;5;231m ⚡ หลวงพี่ · AUTOSCRIPT\E[K\E[0m"
echo -e "$barra"
echo -e "\033[0m"
echo -e "\033[1;38;5;82mIP:\033[1;38;5;231m $IP"
echo -e "\033[1;38;5;82mชื่อผู้ใช้:\033[1;38;5;231m $nome"
echo -e "\033[1;38;5;82mรหัสผ่าน:\033[1;38;5;231m $pass"
echo -e "\033[1;38;5;82mจำกัด:\033[1;38;5;231m $limit"
echo -e "\033[1;38;5;82mเวลา:\033[1;38;5;231m $u_temp นาที"
echo ""
echo -e "\033[1;38;5;227mหลังจากหมดเวลาที่ผู้ใช้งานกำหนด    "
echo -e "\033[1;38;5;227mผู้ใช้งาน \033[1;38;5;82m$nome \033[1;38;5;227mจะถูกตัดการเชื่อมต่อและถูกลบ    \033[0m"
exit
