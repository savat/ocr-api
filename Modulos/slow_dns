#!/bin/bash
_w=$(tput cols 2>/dev/null); [[ "$_w" =~ ^[0-9]+$ ]] || _w=40; (( _w > 60 )) && _w=60; (( _w < 20 )) && _w=20; barra="\033[38;5;177m$(printf '─%.0s' $(seq 1 $_w))\033[0m"
clear
slowdns () {
echo -e "\E[48;5;162;1;38;5;231m ⚡ หลวงพี่ · AUTOSCRIPT\E[K\E[0m"
echo -e "$barra"
echo -e "\033[0m"
    echo -e "\033[38;5;80m[01]\033[m | Install SlowDNS SSH"
    echo -e "\033[38;5;80m[02]\033[m | Install SlowDNS SSL"
    echo -e "\033[38;5;80m[03]\033[m | Install SlowDNS DROP"
    echo -e "\033[38;5;80m[04]\033[m | Install SlowDNS SOCKS"
    echo -e "\033[38;5;80m[05]\033[m | Ver information"
    echo -e "\033[38;5;80m[06]\033[m | Start SlowDNS"
    echo -e "\033[38;5;80m[07]\033[m | Restart SlowDNS"
    echo -e "\033[38;5;80m[08]\033[m | To stop SlowDNS"
    echo -e "\033[38;5;80m[09]\033[m | Remover SlowDNS"
    echo -e "\033[38;5;80m[10]\033[m | To update/Reinstall"
    echo -e "\033[38;5;80m[11]\033[m | Remover Script"
    echo -e "\033[38;5;80m[00]\033[m | ย้อนกลับ      "
    echo ""
    echo -ne "\033[1;38;5;213m❯ \033[1;38;5;231mเลือกเมนู \033[1;38;5;213m› \033[1;38;5;231m" && read opcao
    case $opcao in
    1) Opcao1 ;;
    2) Opcao2 ;;
    3) Opcao3 ;;
    4) Opcao4 ;;
    5) Opcao5 ;;
    6) Opcao6 ;;
    7) Opcao7 ;;
    8) Opcao8 ;;
    9) Opcao9 ;;
    10) Opcao10 ;;
    11) Opcao11 ;;
    00) Sair ;;
    *) "" ; echo ; slowdns ;;
    esac
    }

Opcao1 () {
    clear
    bash /etc/slowdns/slowdns-ssh
}

Opcao2 () {
    clear
    bash /etc/slowdns/slowdns-ssl
}

Opcao3 () {
    clear
    bash /etc/slowdns/slowdns-drop
}

Opcao4 () {
    clear
    bash /etc/slowdns/slowdns-socks
}


Opcao5 () {
    clear
    bash /etc/slowdns/slowdns-info
}

Opcao6 () {
    clear
    bash /etc/slowdns/startdns
}

Opcao7 () {
    clear
    bash /etc/slowdns/restartdns
}

Opcao8 () {
    clear
    bash /etc/slowdns/stopdns
}

Opcao9 () {
     clear
    bash /etc/slowdns/stopdns
    bash /etc/slowdns/remove-slow
}

Opcao10 () {
    clear
    wget -q https://raw.githubusercontent.com/savat/ocr-api/main/Install/update
    chmod +x update
    bash update
}

Opcao11 () {
     clear
    bash /etc/slowdns/remove-slow
    echo -e "\033[38;5;203mSlowDNS Manager ถอนการติดตั้งแล้ว !\033[0m"
    sleep 2
    rm /bin/slowdns
}

Sair() {
    clear
    exit
}
clear
slowdns