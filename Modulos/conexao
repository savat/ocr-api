#!/bin/bash
_w=$(tput cols 2>/dev/null); [[ "$_w" =~ ^[0-9]+$ ]] || _w=40; (( _w > 60 )) && _w=60; (( _w < 20 )) && _w=20; barra="\033[38;5;177m$(printf '─%.0s' $(seq 1 $_w))\033[0m"
[[ $(awk -F" " '{print $2}' /usr/lib/licence) == "@หลวงพี่" ]] && {
	ram1=$(free -h | grep -i mem | awk {'print $2'})
	ram2=$(free -h | grep -i mem | awk {'print $4'})
	ram3=$(free -h | grep -i mem | awk {'print $3'})
	uso=$(top -bn1 | awk '/Cpu/ { cpu = "" 100 - $8 "%" }; END { print cpu }')
	system=$(cat /etc/issue.net)
	fun_bar() {
		comando[0]="$1"
		comando[1]="$2"
		(
			[[ -e $HOME/fim ]] && rm $HOME/fim
			${comando[0]} >/dev/null 2>&1
			${comando[1]} >/dev/null 2>&1
			touch $HOME/fim
		) >/dev/null 2>&1 &
		tput civis
		echo -ne "\033[1;38;5;227mโปรดรอสักครู่ \033[1;38;5;231m- \033[1;38;5;227m["
		while true; do
			for ((i = 0; i < 18; i++)); do
				echo -ne "\033[1;38;5;51m━"
				sleep 0.1s
			done
			[[ -e $HOME/fim ]] && rm $HOME/fim && break
			echo -e "\033[1;38;5;227m]"
			sleep 1s
			tput cuu1
			tput dl1
			echo -ne "\033[1;38;5;227mโปรดรอสักครู่ \033[1;38;5;231m- \033[1;38;5;227m["
		done
		echo -e "\033[1;38;5;227m]\033[1;38;5;231m -\033[1;38;5;82m ✓ เสร็จแล้ว\033[1;38;5;231m"
		tput cnorm
	}

	verif_ptrs() {
		porta=$1
		PT=$(lsof -V -i tcp -P -n | grep -v "ESTABLISHED" | grep -v "COMMAND" | grep "LISTEN")
		for pton in $(echo -e "$PT" | cut -d: -f2 | cut -d' ' -f1 | uniq); do
			svcs=$(echo -e "$PT" | grep -w "$pton" | awk '{print $1}' | uniq)
			[[ "$porta" = "$pton" ]] && {
				echo -e "\n\033[1;38;5;203mพอร์ต \033[1;38;5;227m$porta \033[1;38;5;203mบริการ \033[1;38;5;231m$svcs\033[0m"
				sleep 3
				fun_conexao
			}
		done
	}

	mine_port () {
	PT=$(lsof -V -i tcp -P -n | grep -v "ESTABLISHED" |grep -v "COMMAND" | grep "LISTEN")
	for porta in `echo -e "$PT" | cut -d: -f2 | cut -d' ' -f1 | uniq`; do
	    svcs=$(echo -e "$PT" | grep -w "$porta" | awk '{print $1}' | uniq)
	    echo -e "\033[1;38;5;213m▸ \033[1;38;5;227m$svcs \033[38;5;247m: \033[1;38;5;231m$porta\033[0m"
	done
	}

	pid_inst () {
	[[ $1 = "" ]] && echo -e "\033[1;38;5;203moff" && return 0
	unset portas
	portas_var=$(lsof -V -i -P -n | grep -v "ESTABLISHED" |grep -v "COMMAND")
	i=0
	while read port; do
	var1=$(echo $port | awk '{print $1}') && var2=$(echo $port | awk '{print $9}' | awk -F ":" '{print $2}')
	[[ "$(echo -e ${portas[@]}|grep "$var1 $var2")" ]] || {
	    portas[$i]="$var1 $var2\n"
	    let i++
 	   }
	done <<< "$portas_var"
	[[ $(echo "${portas[@]}"|grep "$1") ]] && echo -e "\033[1;38;5;82mon" || echo -e "\033[1;38;5;203moff"
	}

	fun_openssh() {
		clear
		echo -e "\E[48;5;162;1;38;5;231m ⚡ หลวงพี่ · AUTOSCRIPT\E[K\E[0m"
		echo -e "$barra"
		echo -e "\033[0m"
		echo -e "\E[48;5;45;38;5;16m 1 \E[0m \033[1;38;5;231mเพิ่มพอร์ต
\E[48;5;45;38;5;16m 2 \E[0m \033[1;38;5;231mลบพอร์ต
\E[48;5;45;38;5;16m 3 \E[0m \033[1;38;5;231mย้อนกลับ\033[0m"
		echo ""
		echo -ne "\033[1;38;5;213m❯ \033[1;38;5;231mเลือกเมนู \033[1;38;5;213m› \033[1;38;5;231m"
		read resp
		if [[ "$resp" = '1' ]]; then
			clear
			echo -e "\E[48;5;162;1;38;5;231m ⚡ หลวงพี่ · AUTOSCRIPT\E[K\E[0m"
			echo -e "$barra"
			echo -e "\033[0m"
			echo -ne "\033[1;38;5;82mเพิ่มพอร์ต \033[1;38;5;227m?\033[1;38;5;231m "
			read pt
			[[ -z "$pt" ]] && {
				echo -e "\n\033[1;38;5;203mพอร์ตไม่ถูกต้อง !   "
				sleep 3
				fun_conexao
			}
			verif_ptrs $pt
			echo -e "\n\033[1;38;5;82mกำลังเพิ่มพอร์ต   \033[0m"
			echo ""
			fun_addpssh() {
				echo "Port $pt" >>/etc/ssh/sshd_config
				service ssh restart
			}
			fun_bar 'fun_addpssh'
			echo -e "\n\033[1;38;5;82mเพิ่มพอร์ตเรียบร้อยแล้ว   \033[0m"
			sleep 3
			fun_conexao
		elif [[ "$resp" = '2' ]]; then
			clear
			echo -e "\E[48;5;162;1;38;5;231m ⚡ หลวงพี่ · AUTOSCRIPT\E[K\E[0m"
			echo -e "$barra"
			echo -e "\n\033[1;38;5;227m[\033[1;38;5;203m!\033[1;38;5;227m] \033[1;38;5;82mพอร์ต \033[1;38;5;231m22 \033[1;38;5;227mไม่สามารถลบได้ !\033[0m"
			echo -e "\n\033[1;38;5;227mพอร์ต: \033[1;38;5;231m$(grep 'Port' /etc/ssh/sshd_config | cut -d' ' -f2 | grep -v 'no' | xargs)\n"
			echo -ne "\033[1;38;5;82mลบพอร์ต \033[1;38;5;227m?\033[1;38;5;231m "
			read pt
			[[ -z "$pt" ]] && {
				echo -e "\n\033[1;38;5;203mพอร์ตไม่ถูกต้อง !   "
				sleep 2
				fun_conexao
			}
			[[ $(grep -wc "$pt" '/etc/ssh/sshd_config') != '0' ]] && {
				echo -e "\n\033[1;38;5;82mกำลังลบพอร์ต   \033[0m"
				echo ""
				fun_delpssh() {
					sed -i "/Port $pt/d" /etc/ssh/sshd_config
					service ssh restart
				}
				fun_bar 'fun_delpssh'
				echo -e "\n\033[1;38;5;82mลบพอร์ตเรียบร้อยแล้ว   \033[0m"
				sleep 2
				fun_conexao
			} || {
				echo -e "\n\033[1;38;5;203mพอร์ตไม่ถูกต้อง !   "
				sleep 2
				fun_conexao
			}
		elif [[ "$resp" = '3' ]]; then
			echo -e "\n\033[1;38;5;203mย้อนกลับ.."
			sleep 2
			fun_conexao
		else
			echo -e "\n\033[1;38;5;203mเมนูไม่ถูกต้อง !   "
			sleep 2
			fun_conexao
		fi
	}

	inst_sqd() {
		if netstat -nltp | grep 'squid' 1>/dev/null 2>/dev/null; then
			echo -e "\E[48;5;162;1;38;5;231m ⚡ หลวงพี่ · AUTOSCRIPT\E[K\E[0m"
			echo -e "$barra"
			echo -e "\033[0m"
			echo -ne "\033[1;38;5;82mลบ Squid \033[1;38;5;203m? \033[1;38;5;227m[Y/N]:\033[1;38;5;231m "
			read resp
			[[ "$resp" = 'y' ]] && {
				echo -e "\n\033[1;38;5;82mกำลังลบ Squid Proxy !\033[0m"
				echo ""
				rem_sqd() {
					[[ -d "/etc/squid" ]] && {
						apt-get remove squid -y >/dev/null 2>&1
						apt-get purge squid -y >/dev/null 2>&1
						rm -rf /etc/squid >/dev/null 2>&1
					}
					[[ -d "/etc/squid3" ]] && {
						apt-get remove squid3 -y >/dev/null 2>&1
						apt-get purge squid3 -y >/dev/null 2>&1
						rm -rf /etc/squid3 >/dev/null 2>&1
						apt autoremove -y >/dev/null 2>&1
					}
				}
				fun_bar 'rem_sqd'
				echo -e "\n\033[1;38;5;82mลบ Squid Proxy เรียบร้อยแล้ว !   \033[0m"
				sleep 2
				clear
				fun_conexao
			} || {
				echo -e "\n\033[1;38;5;203mย้อนกลับ...\033[0m"
				sleep 2
				clear
				fun_conexao
			}
		else
			clear
			echo -e "\E[48;5;162;1;38;5;231m ⚡ หลวงพี่ · AUTOSCRIPT\E[K\E[0m"
			echo -e "$barra"
			echo -e "\033[0m"
			IP=$(wget -qO- ipv4.icanhazip.com)
			echo -ne "\033[1;38;5;82mIP เซิร์ฟเวอร์: \033[1;38;5;231m"
			read -e -i $IP ipdovps
			[[ -z "$ipdovps" ]] && {
				echo -e "\n\033[1;38;5;203mIP ไม่ถูกต้อง !    \033[1;38;5;82m"
				echo ""
				read -p "IP เซิร์ฟเวอร์: " IP
			}
			echo -e "\n\033[1;38;5;227mคุณต้องการใช้พอร์ตใดใน Squid \033[1;38;5;203m?"
			echo -e "\n\033[1;38;5;227m[\033[1;38;5;203m!\033[1;38;5;227m] \033[1;38;5;82mตัวอย่าง \033[1;38;5;227mเช่น: \033[1;38;5;231m8080 3128"
			echo ""
			echo -ne "\033[1;38;5;82mเพิ่มพอร์ต\033[1;38;5;231m: "
			read -e -i 8080 portass
			[[ -z "$portass" ]] && {
				echo -e "\n\033[1;38;5;203mพอร์ตไม่ถูกต้อง !   "
				sleep 3
				fun_conexao
			}
			for porta in $(echo -e $portass); do
				verif_ptrs $porta
			done
			[[ $(grep -wc '14' /etc/issue.net) != '0' ]] || [[ $(grep -wc '8' /etc/issue.net) != '0' ]] && {
				echo -e "\n\033[1;38;5;82mกำลังติดตั้ง Squid Proxy\033[0m\n"
				fun_bar 'apt update -y' "apt install squid3 -y"
			} || {
				echo -e "\n\E[48;5;45;38;5;16m 1 \E[0m \033[1;38;5;231mSQUID เวอร์ชัน 3.3.X\n\E[48;5;45;38;5;16m 2 \E[0m \033[1;38;5;231mSQUID เวอร์ชัน 3.5.X\033[0m\n"
				read -p "$(echo -e "\033[1;38;5;213m❯ \033[1;38;5;231mเลือกเมนู \033[1;38;5;213m› \033[1;38;5;231m")" -e -i 1 opc
				[[ -z "$opc" ]] && {
					echo -e "\n\033[1;38;5;203mเมนูไม่ถูกต้อง !  "
					sleep 2
					fun_conexao
				}
				[[ "$opc" != '1' ]] && {
					[[ "$opc" != '2' ]] && {
						echo -e "\n\033[1;38;5;203mเมนูไม่ถูกต้อง !  "
						sleep 2
						fun_conexao
					}
				}
				echo -e "\n\033[1;38;5;82mกำลังตรวจสอบการอัปเดต   \033[0m\n"
				fun_bar 'apt update -y' "instsqd $opc"
			}
			if [[ -d "/etc/squid/" ]]; then
				var_sqd="/etc/squid/squid.conf"
				var_pay="/etc/squid/payload.txt"
			elif [[ -d "/etc/squid3/" ]]; then
				var_sqd="/etc/squid3/squid.conf"
				var_pay="/etc/squid3/payload.txt"
			else
				echo -e "\n\033[1;38;5;227m[\033[1;38;5;203mข้อผิดพลาด\033[1;38;5;227m]\033[1;38;5;231m: \033[1;38;5;227mSquid Proxy ติดตั้งไม่ผ่าน   \033[0m"
				sleep 2
				fun_conexao
			fi
			cat <<-EOF >$var_pay
				.whatsapp.net/
				.facebook.net/
				.twitter.com/
				.speedtest.net/
			EOF
			cat <<-EOF >$var_sqd
				acl url1 dstdomain -i 127.0.0.1
				acl url2 dstdomain -i localhost
				acl url3 dstdomain -i $ipdovps
				acl url4 dstdomain -i /AutoScript?
				acl payload url_regex -i "$var_pay"
				acl all src 0.0.0.0/0

				http_access allow url1
				http_access allow url2
				http_access allow url3
				http_access allow url4
				http_access allow payload
				http_access deny all
				 
				#Portas
			EOF
			for Pts in $(echo -e $portass); do
				echo -e "http_port $Pts" >>$var_sqd
				[[ -f "/usr/sbin/ufw" ]] && ufw allow $Pts/tcp
			done
			cat <<-EOF >>$var_sqd
				#Nome squid
				visible_hostname autoscript.local
				via off
				forwarded_for off
				pipeline_prefetch off
			EOF
			sqd_conf() {
				[[ -d "/etc/squid/" ]] && {
					service ssh restart
					/etc/init.d/squid restart
					service squid restart
				}
				[[ -d "/etc/squid3/" ]] && {
					service ssh restart
					/etc/init.d/squid3 restart
					service squid3 restart
				}
			}
			echo -e "\n\033[1;38;5;82mกำลังตั้งค่าระบบ   \033[0m"
			echo ""
			fun_bar 'sqd_conf'
			echo -e "\n\033[1;38;5;82mSquid Proxy ติดตั้งเรียบร้อยแล้ว !   \033[0m"
			sleep 2.5s
			fun_conexao
		fi
	}

	addpt_sqd() {
		echo -e "\E[48;5;162;1;38;5;231m ⚡ หลวงพี่ · AUTOSCRIPT\E[K\E[0m"
		echo -e "$barra"
		echo -e "\n\033[1;38;5;227mพอร์ต: \033[1;38;5;82m$sqdp\n"
		if [[ -f "/etc/squid/squid.conf" ]]; then
			var_sqd="/etc/squid/squid.conf"
		elif [[ -f "/etc/squid3/squid.conf" ]]; then
			var_sqd="/etc/squid3/squid.conf"
		else
			echo -e "\n\033[1;38;5;203mSquid Proxy ยังไม่ถูกติดตั้ง !   \033[0m"
			echo -e "\n\033[1;38;5;203mย้อนกลับ...\033[0m"
			sleep 2
			clear
			fun_squid
		fi
		echo -ne "\033[1;38;5;82mเพิ่มพอร์ต \033[1;38;5;227m?\033[1;38;5;231m "
		read pt
		[[ -z "$pt" ]] && {
			echo -e "\n\033[1;38;5;203mพอร์ตไม่ถูกต้อง !   "
			sleep 2
			clear
			fun_conexao
		}
		verif_ptrs $pt
		echo -e "\n\033[1;38;5;82mกำลังเพิ่มพอร์ต !  "
		echo ""
		sed -i "s/#Portas/#Portas\nhttp_port $pt/g" $var_sqd
		fun_bar 'sleep 2'
		echo -e "\n\033[1;38;5;82mกำลังตั้งค่า Squid Proxy !   "
		echo ""
		fun_bar 'service squid restart' 'service squid3 restart'
		echo -e "\n\033[1;38;5;82mSquid Proxy ติดตั้งเรียบร้อยแล้ว !   "
		sleep 3
		clear
		fun_squid
	}

	rempt_sqd() {
		echo -e "\E[48;5;162;1;38;5;231m ⚡ หลวงพี่ · AUTOSCRIPT\E[K\E[0m"
		echo -e "$barra"
		echo -e "\n\033[1;38;5;227mพอร์ต: \033[1;38;5;82m$sqdp\n"
		if [[ -f "/etc/squid/squid.conf" ]]; then
			var_sqd="/etc/squid/squid.conf"
		elif [[ -f "/etc/squid3/squid.conf" ]]; then
			var_sqd="/etc/squid3/squid.conf"
		else
			echo -e "\n\033[1;38;5;203mSquid Proxy ยังไม่ถูกติดตั้ง !   \033[0m"
			echo -e "\n\033[1;38;5;203mย้อนกลับ...\033[0m"
			sleep 2
			clear
			fun_squid
		fi
		echo -ne "\033[1;38;5;82mลบพอร์ต \033[1;38;5;227m?\033[1;38;5;231m "
		read pt
		[[ -z "$pt" ]] && {
			echo -e "\n\033[1;38;5;203mพอร์ตไม่ถูกต้อง !   "
			sleep 2
			clear
			fun_conexao
		}
		if grep -E "$pt" $var_sqd >/dev/null 2>&1; then
			echo -e "\n\033[1;38;5;82mกำลังลบพอร์ต Squid Proxy !   "
