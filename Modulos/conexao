			echo -e "\n\033[1;38;5;203mพอร์ต \033[1;38;5;82m$pt \033[1;38;5;203mไม่มีในระบบ !   "
			sleep 3.5s
			clear
			fun_squid
		fi
	}

	fun_squid() {
		[[ "$(netstat -nplt | grep -c 'squid')" = "0" ]] && inst_sqd
		echo -e "\E[48;5;162;1;38;5;231m ⚡ หลวงพี่ · AUTOSCRIPT\E[K\E[0m"
		echo -e "$barra"
		[[ "$(netstat -nplt | grep -c 'squid')" != "0" ]] && {
			sqdp=$(netstat -nplt | grep 'squid' | awk -F ":" {'print $4'} | xargs)
			echo -e "\n\033[1;38;5;227mพอร์ต\033[1;38;5;231m: \033[1;38;5;82m$sqdp"
			VarSqdOn="ถอนติดตั้ง Squid Proxy"
		} || {
			VarSqdOn="ติดตั้ง Squid Proxy"
		}
		echo -e "\n\E[48;5;45;38;5;16m 1 \E[0m \033[1;38;5;231m$VarSqdOn 
\E[48;5;45;38;5;16m 2 \E[0m \033[1;38;5;231mเพิ่มพอร์ต Squid Proxy 
\E[48;5;45;38;5;16m 3 \E[0m \033[1;38;5;231mลบพอร์ต Squid Proxy 
\E[48;5;45;38;5;16m 4 \E[0m \033[1;38;5;231mเพิ่ม Host 
\E[48;5;45;38;5;16m 5 \E[0m \033[1;38;5;231mลบ Host 
\E[48;5;160;1;38;5;231m 0 \E[0m \033[1;38;5;231mย้อนกลับ\033[0m"
		echo ""
		echo -ne "\033[1;38;5;213m❯ \033[1;38;5;231mเลือกเมนู \033[1;38;5;213m› \033[1;38;5;231m"
		read x
		clear
		case $x in
		1 | 01)
			inst_sqd
			;;
		2 | 02)
			addpt_sqd
			;;
		3 | 03)
			rempt_sqd
			;;
		4 | 04)
			clear
			addhost
			echo -ne "\n\033[1;38;5;213m↵ \033[1;38;5;231mแตะ Enter เพื่อกลับเมนู\033[0m"; read
			fun_squid
			;;
		5 | 05)
			clear
			delhost
			echo -ne "\n\033[1;38;5;213m↵ \033[1;38;5;231mแตะ Enter เพื่อกลับเมนู\033[0m"; read
			fun_squid
			;;
		0 | 00)
			echo -e "\033[1;38;5;203mย้อนกลับ...\033[0m"
			sleep 1
			fun_conexao
			;;
		*)
			echo -e "\033[1;38;5;203mเมนูไม่ถูกต้อง...\033[0m"
			sleep 2
			fun_conexao
			;;
		esac
	}

	fun_drop() {
