			sed -i "/http_port $pt/d" $var_sqd
			fun_bar 'sleep 3'
			echo -e "\n\033[1;38;5;82mกำลังตั้งค่า Squid Proxy !   "
			echo ""
			fun_bar 'service squid restart' 'service squid3 restart'
			echo -e "\n\033[1;38;5;82mลบพอร์ต Squid Proxy เรียบร้อยแล้ว !   "
			sleep 3.5s
			clear
			fun_squid
