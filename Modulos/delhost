#!/bin/bash
_w=$(tput cols 2>/dev/null); [[ "$_w" =~ ^[0-9]+$ ]] || _w=40; (( _w > 60 )) && _w=60; (( _w < 20 )) && _w=20; barra="\033[38;5;177m$(printf '─%.0s' $(seq 1 $_w))\033[0m"
if [ -d "/etc/squid/" ]; then
    payload="/etc/squid/payload.txt"
elif [ -d "/etc/squid3/" ]; then
	payload="/etc/squid3/payload.txt"
fi
echo -e "\E[48;5;162;1;38;5;231m ⚡ หลวงพี่ · AUTOSCRIPT\E[K\E[0m"
echo -e "$barra"
if [ ! -f "$payload" ]
then
	tput setaf 7 ; tput setab 0 ; tput bold ; echo "" ; echo "ไฟล์ $payload ไม่พบ   " ; tput sgr0
	exit 1
else
	tput setaf 2 ; tput bold ; echo ""; echo "โดเมนปัจจุบันในไฟล์ $payload:" ; tput sgr0
	tput setaf 3 ; tput bold ; echo "" ; cat $payload ; echo "" ; tput sgr0
	read -p "Remove Domin: " host
	if [[ -z $host ]]
		then
			tput setaf 7 ; tput setab 0 ; tput bold ; echo "" ; echo "คุณป้อนโดเมนว่างหรือไม่มีอยู่ !" ; echo "" ; tput sgr0
			exit 1
		else
		if [[ `grep -c "^$host" $payload` -ne 1 ]]
		then
			tput setaf 7 ; tput setab 0 ; tput bold ; echo "" ; echo "โดเมน $host ไม่พบในไฟล์ $payload" ; echo "" ; tput sgr0
			exit 1
		else
			grep -v "^$host" $payload > /tmp/a && mv /tmp/a $payload
			tput setaf 7 ; tput setab 0 ; tput bold ; echo "" ; echo "ไฟล์ $payload อัปเดตแล้ว โดเมนถูกลบออกเรียบร้อยแล้ว:" ; tput sgr0
			tput setaf 3 ; tput bold ; echo "" ; cat $payload ; echo "" ; tput sgr0
			if [ ! -f "/etc/init.d/squid3" ]
			then
				service squid3 reload
			elif [ ! -f "/etc/init.d/squid" ]
			then
				service squid reload
			fi	
			tput setaf 7 ; tput setab 0 ; tput bold ; echo "" ; echo "Squid Proxy รีบูตใหม่เรียบร้อย !" ; echo "" ; tput sgr0
			exit 1
		fi
	fi
fi