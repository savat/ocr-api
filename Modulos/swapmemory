#!/bin/bash
fun_swap() {
    clear
		echo -e "\033[1;31m════════════════════════════════════════════════════\033[0m"
		echo -e "\E[44;1;37m             ⇱ ออโต้สคริป โดย หลวงพี่ ⇲              \E[0m"
		echo -e "\033[1;31m════════════════════════════════════════════════════\033[0m"
		echo -e "\033[0m"
		echo -e "\033[1;31m[\033[1;36m1\033[1;31m] \033[1;37m• \033[1;33mเพิ่มแรมสำรอง Swap      \033[0m"
		echo -e "\033[1;31m[\033[1;36m2\033[1;31m] \033[1;37m• \033[1;33mลบแรมที่สำรอง Swap      \033[0m"
		echo -e "\033[1;31m[\033[1;36m0\033[1;31m] \033[1;37m• \033[1;33mย้อนกลับ       \033[0m"
		echo ""
		echo -ne "\033[1;32mSelect Menu \033[1;33m?\033[1;37m "
		read resposta
		if [[ "$resposta" = '1' ]]; then
            clear
			echo -e "\033[1;31m════════════════════════════════════════════════════\033[0m"
			echo -e "\E[44;1;37m             ⇱ ออโต้สคริป โดย หลวงพี่ ⇲              \E[0m"
			echo -e "\033[1;31m════════════════════════════════════════════════════\033[0m"
			echo -e "\033[0m"
			echo -e "\033[0;37mใส่เป็นหน่วยเท่านั้นเช่น 2 = (2GB)      \033[0m"
			echo -ne "\033[1;32mAdd Swap \033[1;33m?\033[1;37m: "
			read gigas
            [[ -z "$gigas" ]] && {
					echo ""
					echo -e "\033[1;31mใส่ไม่ถูกต้อง !"
					sleep 2
					clear
					menu
				}
            echo ""
			echo -e "\033[1;32mตอนนี้ตั้งค่าเป็น \033[1;31m$gigas GB\033[1;33m"
			echo ""
            swapoff -a
            rm -rf /bin/ram.img > /dev/null 2>&1
            fallocate -l ${gigas}G /bin/ram.img > /dev/null 2>&1
            chmod 600 /bin/ram.img > /dev/null 2>&1
            mkswap /bin/ram.img > /dev/null 2>&1
            swapon /bin/ram.img > /dev/null 2>&1
            echo 50  > /proc/sys/vm/swappiness
            echo '/bin/ram.img none swap sw 0 0' | sudo tee -a /etc/fstab > /dev/null 2>&1
			echo -e "\033[1;32mMemory Swap ตั้งค่าเรียบร้อย     \033[1;33m"
            sleep 2
			fun_swap
        elif [[ "$resposta" = '2' ]]; then
            clear
			echo -e "\033[1;31m════════════════════════════════════════════════════\033[0m"
			echo -e "\E[44;1;37m             ⇱ ออโต้สคริป โดย หลวงพี่ ⇲              \E[0m"
			echo -e "\033[1;31m════════════════════════════════════════════════════\033[0m"
			echo -e "\033[0m"
            swapoff -a
            rm -rf /bin/ram.img > /dev/null 2>&1
			echo -e "\033[1;32mMemory Swap ที่สำรองถูกลบเรียบร้อย !\033[1;33m"
			sleep 2
			fun_swap
        elif [[ "$resposta" = '0' ]]; then
			echo ""
			echo -e "\033[1;31mย้อนกลับ...\033[0m"
			sleep 1
			menu
		else
			echo ""
			echo -e "\033[1;31mเมนูไม่ถูกต้อง !\033[0m"
			sleep 1
			fun_swap
		fi 
}
fun_swap