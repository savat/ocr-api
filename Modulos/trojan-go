        [[ $debug = "enable" ]] && echo -e "${OK} ${GreenBG} $1 รีบูต ${Font}"
    else
        echo -e "\n${Error} ${RedBG} $1 ไม่สามารถรีบูตได้ ตัวเลือกต่อไปนี้จะถูกบล็อก โปรดแก้ไขและลองอีกครั้ง... ${Font}"
        [[ $1 = "tls-shunt-proxy" ]] && echo -e "${Yellow}[ป้องกัน] ติดตั้งพร็อกซี TCP / WS (Trojan-Go / V2Ray) \n(Trojan-Go / V2Ray) \n[บล็อก] ดูข้อมูลการกำหนดค่า ${Font}"
        [[ $1 = "docker" ]] && echo -e "${Yellow}[ป้องกัน] ติดตั้ง / ถอนการติดตั้ง WatchTower \n[ป้องกัน] ติดตั้ง / ถอนการติดตั้ง  Portainer ${Font}"
        read -t 60 -n 1 -s -rp "Enter（60s）..."
    fi
}

