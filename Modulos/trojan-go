        [[ $v2ray_ws_mode = null ]] && v2ray_ws_mode=none
        [[ $v2wspath = null ]] && v2wspath=/v2ray/none
        echo -e "ตรวจพบ: พร็อกซี V2Ray：TCP：${Green}${v2ray_tcp_mode}${Font} พอร์ต：${Green}${v2port}${Font} / WebSocket：${Green}${v2ray_ws_mode}${Font} พอร์ต：${Green}${v2wsport}${Font} / WebSocket เส้นทาง：${Green}${v2wspath}${Font}"
    fi

    if [[ -f ${tsp_conf} ]]; then
        trojan_sync
        v2ray_sync
        tsp_config_stat="synchronized"
        systemctl restart tls-shunt-proxy
        judge "กำหนดค่า tls-shunt-proxy"
        menu_req_check tls-shunt-proxy
