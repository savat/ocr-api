#!/bin/bash
_w=$(tput cols 2>/dev/null); [[ "$_w" =~ ^[0-9]+$ ]] || _w=40; (( _w > 60 )) && _w=60; (( _w < 20 )) && _w=20; barra="\033[38;5;177m$(printf '─%.0s' $(seq 1 $_w))\033[0m"
clear
fun_prog ()
{
	comando[0]="$1" 
    ${comando[0]}  > /dev/null 2>&1 & 
	tput civis
	echo -ne "\033[1;38;5;82m.\033[1;38;5;227m.\033[1;38;5;203m. \033[1;38;5;82m"
    while [ -d /proc/$! ]
	do
		for i in / - \\ \|
		do
			sleep .1
			echo -ne "\e[1D$i"
		done
	done
	tput cnorm
	echo -e "\e[1DOK"
}
echo -e "\E[48;5;162;1;38;5;231m ⚡ หลวงพี่ · AUTOSCRIPT\E[K\E[0m"
echo -e "$barra"
echo ""
echo -ne "\033[1;38;5;227mกำลังอัปเดตระบบ"; fun_prog 'apt-get update -y'
apt-get update -y > /dev/null 2>&1
echo ""
sleep 1
echo -ne "\033[1;38;5;227mกำลังอัปเกรดระบบ"; fun_prog 'apt-get upgrade -y'
apt-get upgrade -y > /dev/null 2>&1
echo ""
sleep 1
echo -e "\033[1;38;5;82mสำเร็จแล้ว!\033[0m"
sleep 1
