#!/bin/bash
_w=$(tput cols 2>/dev/null); [[ "$_w" =~ ^[0-9]+$ ]] || _w=40; (( _w > 60 )) && _w=60; (( _w < 20 )) && _w=20; barra="\033[0;35m$(printf '─%.0s' $(seq 1 $_w))\033[0m"
clear
echo -e "\E[45;1;37m ⚡ หลวงพี่ · AUTOSCRIPT\E[K\E[0m"
echo -e "$barra"
echo -e "\033[1;35m▍\033[1;36mทดสอบความเร็วเน็ตเซิร์ฟเวอร์\033[0m"
echo ""
command -v speedtest-cli >/dev/null 2>&1 || { pip3 install speedtest-cli >/dev/null 2>&1 || pip3 install --break-system-packages speedtest-cli >/dev/null 2>&1 || apt-get install -y speedtest-cli >/dev/null 2>&1; }
if command -v speedtest-cli >/dev/null 2>&1; then
  _out=$(speedtest-cli --simple --secure 2>/dev/null || speedtest-cli --simple 2>/dev/null)
  if [[ -n "$_out" ]]; then
    echo -e "\033[1;36mปิง       \033[1;37m$(echo "$_out" | awk '/^Ping/{print $2" "$3}')\033[0m"
    echo -e "\033[1;36mดาวน์โหลด \033[1;32m$(echo "$_out" | awk '/^Download/{print $2" "$3}')\033[0m"
    echo -e "\033[1;36mอัปโหลด   \033[1;33m$(echo "$_out" | awk '/^Upload/{print $2" "$3}')\033[0m"
  else
    echo -e "\033[1;31m✘ ทดสอบไม่สำเร็จ ตรวจสอบอินเทอร์เน็ต\033[0m"
  fi
else
  echo -e "\033[1;31m✘ ไม่พบ speedtest-cli และติดตั้งไม่สำเร็จ\033[0m"
fi
echo -e "$barra"
read -r -p "↵ แตะ Enter เพื่อกลับเมนู... " _
