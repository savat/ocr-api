#!/bin/bash
_w=$(tput cols 2>/dev/null); [[ "$_w" =~ ^[0-9]+$ ]] || _w=40; (( _w > 60 )) && _w=60; (( _w < 20 )) && _w=20; barra="\033[38;5;177m$(printf '─%.0s' $(seq 1 $_w))\033[0m"
echo -e "\E[48;5;162;1;38;5;231m ⚡ หลวงพี่ · AUTOSCRIPT\E[K\E[0m"
echo -e "$barra"
echo ""
echo -e "\033[1;38;5;203mคำเตื่อน !!\033[0m"
echo " "
echo -e "\033[1;38;5;227mรหัสผ่านนี้จะใช้ในการเข้าสู่เซิร์ฟเวอร์ของคุณ       \033[0m"
echo " "
echo -ne "\033[1;38;5;82mรหัสผ่านใหม่\033[1;38;5;231m: "; read senha
[[ -z "$senha" ]] && {
echo -e "\n\033[1;38;5;203mรหัสผ่านไม่ถูกต้อง !\033[0m"
exit 0
}
echo "root:$senha" | chpasswd
sleep 1s
echo -e "\n\033[1;38;5;82mเปลี่ยนรหัสผ่านเรียบร้อย !\033[0m"
sleep 3s
cd
clear

