#!/bin/bash
echo -e "\E[45;1;37m ⚡ หลวงพี่ · AUTOSCRIPT\E[K\E[0m"
echo -e "\033[0;35m────────────────────────────────────\033[0m"
echo ""
echo -e "\033[1;31mคำเตื่อน !!\033[0m"
echo " "
echo -e "\033[1;33mรหัสผ่านนี้จะใช้ในการเข้าสู่เซิร์ฟเวอร์ของคุณ       \033[0m"
echo " "
echo -ne "\033[1;32mNew Password\033[1;37m: "; read senha
[[ -z "$senha" ]] && {
echo -e "\n\033[1;31mรหัสผ่านไม่ถูกต้อง !\033[0m"
exit 0
}
echo "root:$senha" | chpasswd
sleep 1s
echo -e "\n\033[1;32mเปลี่ยนรหัสผ่านเรียบร้อย !\033[0m"
sleep 3s
cd
clear

