        ports=${port_service[x-ui]}
        echo ""
  	  echo -e "\033[1;31m \033[1;33mURL WebPanel V2ray    \033[0m"
        echo -e " \033[1;32mhttp://$IP:$ports\033[0m"
    
}
mine_port
   echo -ne "\n\033[1;35m↵ \033[1;37mแตะ Enter เพื่อกลับเมนู\033[0m"; read
   ;;   
   13 | 13)
   fun_backup
   echo -ne "\n\033[1;35m↵ \033[1;37mแตะ Enter เพื่อกลับเมนู\033[0m"; read
   ;;   
   0 | 00)
   menu
   exit;
   ;;
   *)
   echo -e "\n\033[1;31mเมนูไม่ถูกต้อง !\033[0m"
   sleep 1
esac
done
}
