#!/bin/bash
_w=$(tput cols 2>/dev/null); [[ "$_w" =~ ^[0-9]+$ ]] || _w=40; (( _w > 60 )) && _w=60; (( _w < 20 )) && _w=20; barra="\033[0;35m$(printf '─%.0s' $(seq 1 $_w))\033[0m"
IP=$(cat /etc/IP)
x="ok"

fun_bar () {
comando[0]="$1"
comando[1]="$2"
 (
[[ -e $HOME/fim ]] && rm $HOME/fim
${comando[0]} -y > /dev/null 2>&1
${comando[1]} -y > /dev/null 2>&1
touch $HOME/fim
 ) > /dev/null 2>&1 &
 tput civis
 local _f=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧') _i=0
 while [[ ! -e $HOME/fim ]]; do
   printf '\r  \033[1;35m%s\033[0m \033[1;37mกำลังทำงาน\033[0m \033[0;90m…\033[0m' "${_f[_i++ % 8]}"
   sleep 0.12
 done
 rm -f $HOME/fim
 printf '\r\033[K  \033[1;32m✔\033[0m \033[1;37mเสร็จแล้ว\033[0m\n'
 tput cnorm
}
fun_backup () {
#!/bin/bash

RED="\033[31m"
GREEN="\033[32m"
YELLOW="\033[33m"
BLUE="\033[34m"
RESET="\033[0m"

echo -e "$RESET"
clear
echo -e "\E[45;1;37m ⚡ หลวงพี่ · AUTOSCRIPT\E[K\E[0m"
echo -e "$barra"
echo -e "\033[0m"
echo -e "${RED}สำรองและคืนค่า ข้อมูลผู้ใช้งาน V2ray${RESET}"
echo -e "${YELLOW}สำรอง/ส่งออกข้อมูล (B)${RESET}"
echo -e "${YELLOW}กู้คืน/นำเข้าข้อมูล (D)${RESET}"
echo -e "\033[0m"
echo -e -n "${GREEN}สำรอง/ส่งออก (B) หรือกู้คืน/นำเข้า (D)?${RESET} "
read mode

if [[ "$mode" == @(b|B) ]]; then
    db_file="/etc/x-ui-english/x-ui-english.db"
    if [ -f "$db_file" ]; then
        response=$(curl -s --upload-file "$db_file" https://transfer.sh/)
        download_link=$(echo "$response")
        if [ -n "$download_link" ]; then
            echo "File uploaded successfully"
			echo "Download link: $download_link"
        else
            echo "Upload failed..."
        fi
    else
        echo "Database file not found: $db_file"
    fi
elif [[ "$mode" == @(d|D) ]]; then
    echo -n "วางลิงก์ไฟล์ฐานข้อมูลโดยตรง: "
    read file_url
    destination_path="/etc/x-ui-english/x-ui-english.db"
    curl -s -o "$destination_path" "$file_url"
    if [ $? -eq 0 ]; then
        echo "File downloaded successfully"
        x-ui restart
    else
        echo "Download failed..."
    fi
else 
    echo "not found"
fi
}
v2raymanager () {
while true $x != "ok"
do

if [[ "$(grep -c "Ubuntu" /etc/issue.net)" = "1" ]]; then
system=$(cut -d' ' -f1 /etc/issue.net)
system+=$(echo ' ')
system+=$(cut -d' ' -f2 /etc/issue.net |awk -F "." '{print $1}')
elif [[ "$(grep -c "Debian" /etc/issue.net)" = "1" ]]; then
system=$(cut -d' ' -f1 /etc/issue.net)
system+=$(echo ' ')
system+=$(cut -d' ' -f3 /etc/issue.net)
else
	system=$(cut -d' ' -f1 /etc/issue.net)
fi

on="\033[30;42m ON \033[0m " && off="\033[100;1;37m OFF \033[0m "
[[ `grep -c "^#autoscript" /etc/sysctl.conf` -eq 0 ]] && tcp=$off || tcp=$on
[[ -e /etc/autoscript-torrent ]] && stsf=$(echo -e "\033[30;42m ON \033[0m ") || stsf=$(echo -e "\033[100;1;37m OFF \033[0m ")
stsbot=$(ps x | grep "bot_plus"|grep -v grep > /dev/null && echo -e "\033[30;42m ON \033[0m " || echo -e "\033[100;1;37m OFF \033[0m ")
autm=$(grep "menu;" /etc/profile > /dev/null && echo -e "\033[30;42m ON \033[0m " || echo -e "\033[100;1;37m OFF \033[0m ")
v2ray_ui=$(ps x | grep "x-ui"|grep -v grep > /dev/null && echo -e "\033[30;42m ON \033[0m " || echo -e "\033[100;1;37m OFF \033[0m ")
stsl=$(ps x | grep "limiter"|grep -v grep > /dev/null && echo -e "\033[30;42m ON \033[0m " || echo -e "\033[100;1;37m OFF \033[0m ")
stsu=$(ps x | grep "udpvpn"|grep -v grep > /dev/null && echo -e "\033[30;42m ON \033[0m " || echo -e "\033[100;1;37m OFF \033[0m ")
_ons=$(ps -x | grep sshd | grep -v root | grep priv | wc -l)
[[ "$(cat /etc/AutoScript/Exp)" != "" ]] && _expuser=$(cat /etc/AutoScript/Exp) || _expuser="0"
[[ -e /etc/openvpn/openvpn-status.log ]] && _onop=$(grep -c "10.8.0" /etc/openvpn/openvpn-status.log) || _onop="0"
[[ -e /etc/default/dropbear ]] && _drp=$(ps aux | grep dropbear | grep -v grep | wc -l) _ondrp=$(($_drp - 1)) || _ondrp="0"
_onli=$(($_ons + $_onop + $_ondrp))
_ram=$(printf ' %-9s' "$(free -h | grep -i mem | awk {'print $2'})")
mb=$(printf '%-8s' "$(free -h | grep Mem | sed 's/\s\+/,/g' | cut -d , -f6)")
_usor=$(printf '%-8s' "$(free -m | awk 'NR==2{printf "%.2f%%", $3*100/$2 }')")
_usop=$(printf '%-1s' "$(top -bn1 | awk '/Cpu/ { cpu = "" 100 - $8 "%" }; END { print cpu }')")
modelo1=$(printf '%-11s' "$(lscpu | grep Arch | sed 's/\s\+/,/g' | cut -d , -f2)")
_core=$(printf '%-1s' "$(grep -c cpu[0-9] /proc/stat)")
_system=$(printf '%-13s' "$system")
_hoje=$(date +'%d/%m/%Y')
_hora=$(printf '%(%H:%M:%S)T')
_onlin=$(printf '%-5s' "$_onli")
_userexp=$(printf '%-5s' "$_expuser")
_tuser=$(awk -F: '$3>=1000 {print $1}' /etc/passwd | grep -v nobody | wc -l)

clear
echo -e "\E[45;1;37m ⚡ หลวงพี่ · AUTOSCRIPT\E[K\E[0m"
echo -e "$barra"
echo -e "\E[30;46m 01 \E[0m \033[1;37mติดตั้ง V2ray $v2ray_ui"
echo -e "\E[30;46m 02 \E[0m \033[1;37mเปิดใช้งาน V2ray"
echo -e "\E[30;46m 03 \E[0m \033[1;37mปิดใช้งาน V2ray"        
echo -e "\E[30;46m 04 \E[0m \033[1;37mรีสตาร์ท V2Ray"        
echo -e "\E[30;46m 05 \E[0m \033[1;37mดูสถานะ V2ray"        
echo -e "\E[30;46m 06 \E[0m \033[1;37mเปิดเซอร์วิส V2ray"        
echo -e "\E[30;46m 07 \E[0m \033[1;37mปิดเซอร์วิส V2ray"        
echo -e "\E[30;46m 08 \E[0m \033[1;37mข้อมูล V2ray"        
echo -e "\E[30;46m 09 \E[0m \033[1;37mอัปเดต V2ray"        
echo -e "\E[30;46m 10 \E[0m \033[1;37mติดตั้งใหม่ V2ray"        
echo -e "\E[30;46m 11 \E[0m \033[1;37mถอนติดตั้ง V2ray"        
echo -e "\E[30;46m 12 \E[0m \033[1;37mลิงก์ WebPanel V2ray"        
echo -e "\E[30;46m 13 \E[0m \033[1;37mสำรอง/คืนค่า V2ray"        
echo -e "\E[41;1;37m 00 \E[0m \033[1;37mย้อนกลับ"
echo -e "$barra"
echo -ne "\033[1;35m❯ \033[1;37mเลือกเมนู \033[1;35m› \033[1;37m"; read x

case "$x" in 
   1 | 01)
   wget -q --no-check-certificate https://raw.githubusercontent.com/savat/ocr-api/main/Install/install.sh && chmod +x install.sh && ./install.sh
   exit;
   ;;
   2 | 02)
   x-ui start
   sleep 2
   ;;
   3 | 03)
   x-ui stop
   sleep 2
   ;;   
   4 | 04)
   x-ui restart
   sleep 2
   ;;   
   5 | 05)
   x-ui status
   ;;   
   6 | 06)
   x-ui enable
   sleep 2
   ;;   
   7 | 07)
   x-ui disable
   sleep 2
   ;;   
   8 | 08)
   x-ui log
   ;;   
   9 | 09)
   x-ui update
   sleep 2
   ;;   
   10 | 10)
   x-ui install
   sleep 2
   ;;   
   11 | 11)
   x-ui uninstall
   sleep 2
   ;;   
   12 | 12)
   mine_port () {
    PT=$(lsof -V -i tcp -P -n | grep -v "ESTABLISHED" | grep -v "COMMAND" | grep "LISTEN")
    
    declare -A port_service
    
    while read -r line; do
        porta=$(echo "$line" | cut -d: -f2 | cut -d' ' -f1)
