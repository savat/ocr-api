#!/bin/bash
if [ -d "/etc/squid/" ]; then
    payload="/etc/squid/payload.txt"
elif [ -d "/etc/squid3/" ]; then
	payload="/etc/squid3/payload.txt"
fi
echo -e "\E[45;1;37m ⚡ หลวงพี่ · AUTOSCRIPT\E[K\E[0m"
echo -e "\033[0;35m────────────────────────────────────\033[0m"
echo -e "\033[0m"
if [ ! -f "$payload" ]
then
	tput setaf 7 ; tput setab 0 ; tput bold ; echo "" ; echo "ไฟล์ $payload ไม่พบ!" ; tput sgr0
	exit 1
else
	tput setaf 2 ; tput bold ; echo "โดเมนปัจจุบันในไฟล์ $payload:" ; tput sgr0
	tput setaf 3 ; tput bold ; echo "" ; cat $payload ; echo "" ; tput sgr0
	read -p "Add Domin: " host
	if [[ -z $host ]]
	then
		tput setaf 7 ; tput setab 0 ; tput bold ; echo "" ; echo "คุณไม่ได้เพิ่มอะไรเลย!" ; echo "" ; tput sgr0
		exit 1
	else
		if [[ `grep -c "^$host" $payload` -eq 1 ]]
		then
			tput setaf 7 ; tput setab 0 ; tput bold ; echo "" ; echo "โดเมน $host มีอยู่แล้วในไฟล์ $payload" ; echo "" ; tput sgr0
			exit 1
		else
			if [[ $host != \.* ]]
			then
				tput setaf 7 ; tput setab 0 ; tput bold ; echo "" ; echo "คุณต้องเพิ่มโดเมนโดยเริ่มต้นด้วยจุด!" ; echo "เช่น .google.com" ; echo "ไม่จำเป็นต้องเพิ่มโดเมนย่อยสำหรับโดเมนที่อยู่ในไฟล์อยู่แล้ว   " ; echo ""; tput sgr0
				exit 1
			else
				echo "$host" >> $payload && grep -v "^$" $payload > /tmp/a && mv /tmp/a $payload
				tput setaf 7 ; tput setab 1 ; tput bold ; echo "" ; echo "ไฟล์ $payload อัปเดต เพิ่มโดเมนสำเร็จแล้ว:" ; tput sgr0
				tput setaf 3 ; tput bold ; echo "" ; cat $payload ; echo "" ; tput sgr0
				if [ ! -f "/etc/init.d/squid3" ]
				then
					service squid3 reload
				elif [ ! -f "/etc/init.d/squid" ]
				then
					service squid reload
				fi	
				tput setaf 7 ; tput setab 0 ; tput bold ; echo "" ; echo "Squid Proxy โหลดใหม่สำเร็จแล้ว!" ; echo "" ; tput sgr0
				exit 1
			fi
		fi
	fi
fi