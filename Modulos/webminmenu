#!/bin/bash
_w=$(tput cols 2>/dev/null); [[ "$_w" =~ ^[0-9]+$ ]] || _w=40; (( _w > 60 )) && _w=60; (( _w < 20 )) && _w=20; barra="\033[0;35m$(printf '─%.0s' $(seq 1 $_w))\033[0m"
# INSTALADOR WEBMIN 2.9 
fun_bar () {
comando[0]="$1"
comando[1]="$2"
 (
[[ -e $HOME/fim ]] && rm $HOME/fim
${comando[0]} -y > /dev/null 2>&1
${comando[1]} -y > /dev/null 2>&1
touch $HOME/fim
 ) > /dev/null 2>&1 &
 tput civis
 local _f=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧') _i=0
 while [[ ! -e $HOME/fim ]]; do
   printf '\r  \033[1;35m%s\033[0m \033[1;37mกำลังทำงาน\033[0m \033[0;90m…\033[0m' "${_f[_i++ % 8]}"
   sleep 0.12
 done
 rm -f $HOME/fim
 printf '\r\033[K  \033[1;32m✔\033[0m \033[1;37mเสร็จแล้ว\033[0m\n'
 tput cnorm
}
IP=$(cat /etc/IP)
web_min ()
{
 [[ -e /etc/webmin/miniserv.conf ]] && {
 clear
 echo -e "\E[45;1;37m ⚡ หลวงพี่ · AUTOSCRIPT\E[K\E[0m"
 echo -e "$barra"
 echo -e "\033[0m"
 echo -e "\033[1;32mเราพร้อมที่จะถอนการติดตั้งเซิร์ฟเวอร์ของคุณแล้ว WEBMIN"
 echo -ne "\n\033[1;32mConfirm \033[1;31m? \033[1;33m[Y/N]:\033[1;37m "; read x
 [[ $x = @(n|N) ]] && clear && conexao
 echo ""
 fun_bar "apt-get remove webmin -y"
 echo ""
 echo -e "\033[1;31m WEBMIN ถอนการติดตั้งแล้ว  ! \033[0m"
 echo ""
 [[ -e /etc/webmin/miniserv.conf ]] && rm /etc/webmin/miniserv.conf
 echo ""
 sleep 3s
 conexao
 exit
 }
## https://clouding.io/hc/es/articles/360010749399-C%C3%B3mo-Instalar-Webmin-en-Ubuntu-18-04
clear
echo -e "\E[45;1;37m ⚡ หลวงพี่ · AUTOSCRIPT\E[K\E[0m"
echo -e "$barra"
echo -e "\033[0m"
echo -ne "\033[1;32mServer IP: \033[1;37m"; read -e -i $IP ip
echo ""
echo -e "\033[1;32mเราพร้อมที่จะติดตั้งเซิร์ฟเวอร์ของคุณแล้ว WEBMIN"
echo -ne "\n\033[1;32mInstall \033[1;31m? \033[1;33m[Y/N]:\033[1;37m "; read x
[[ $x = @(n|N) ]] && clear && conexao
echo ""
# Actualiza Sistema
echo -e "\033[1;31m[ ! ] apt-get update"
apt-get update -y > /dev/null 2>&1
apt-get upgrade -y > /dev/null 2>&1
service ssh restart > /dev/null 2>&1
# Install webmin Manager
echo -e "\033[1;31m[ ! ] add-apt-repository"
apt-get install software-properties-common apt-transport-https wget -y > /dev/null 2>&1
wget -q http://www.webmin.com/jcameron-key.asc -O- | apt-key add -  > /dev/null 2>&1
add-apt-repository "deb [arch=amd64] http://download.webmin.com/download/repository sarge contrib"  > /dev/null 2>&1
echo -e "\033[1;31m[ ! ] apt-get install webmin"
apt-get install webmin -y > /dev/null 2>&1
echo -e "\033[1;32m"
ufw allow 10000/tcp
sleep 1s
echo ""
service webmin restart > /dev/null 2>&1
echo -e "\033[1;37m เข้าผ่านทาง WEBMIN https://$IP:10000 \033[0m"
echo ""
echo -e "\033[1;32m ติดตั้งเรียบร้อยแล้ว ! \033[0m"
echo -ne "\n\033[1;35m↵ \033[1;37mแตะ Enter เพื่อกลับเมนู\033[0m"; 
read ENTER
conexao
exit
}
web_min
#fim