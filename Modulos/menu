#!/bin/bash
_w=$(tput cols 2>/dev/null); [[ "$_w" =~ ^[0-9]+$ ]] || _w=40; (( _w > 60 )) && _w=60; (( _w < 20 )) && _w=20; barra="\033[0;35m$(printf '─%.0s' $(seq 1 $_w))\033[0m"
IP=$(cat /etc/IP 2>/dev/null)
x="ok"

fun_bar () {
comando[0]="$1"
comando[1]="$2"
 (
[[ -e $HOME/fim ]] && rm $HOME/fim
${comando[0]} -y > /dev/null 2>&1
${comando[1]} -y > /dev/null 2>&1
touch $HOME/fim
 ) > /dev/null 2>&1 &
 tput civis
 local _f=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧') _i=0
 while [[ ! -e $HOME/fim ]]; do
   printf '\r  \033[1;35m%s\033[0m \033[1;37mกำลังทำงาน\033[0m \033[0;90m…\033[0m' "${_f[_i++ % 8]}"
   sleep 0.12
 done
 rm -f $HOME/fim
 printf '\r\033[K  \033[1;32m✔\033[0m \033[1;37mเสร็จแล้ว\033[0m\n'
 tput cnorm
}

menu ()
{
function autoexec () {
   if grep "menu;" /etc/profile > /dev/null; then
      clear
      echo -e "\E[45;1;37m ⚡ หลวงพี่ · AUTOSCRIPT\E[K\E[0m"
      echo -e "$barra"
      echo ""
      echo -e "\033[1;31mปิดใช้งาน... \033[0m"
      offautmenu () {
         sed -i '/menu;/d' /etc/profile
      }
      echo ""
      fun_bar 'offautmenu'
      sleep 1.5s
      menu
   else
      clear
      echo -e "\E[45;1;37m ⚡ หลวงพี่ · AUTOSCRIPT\E[K\E[0m"
      echo -e "$barra"
      echo -e "\n\033[1;32mเปิดใช้งาน... \033[0m"
      autmenu () {
         grep -v "^menu;" /etc/profile > /tmp/tmpass && mv /tmp/tmpass /etc/profile
         echo "menu;" >> /etc/profile
      }
      echo ""
      fun_bar 'autmenu'
      sleep 1.5s
      menu
   fi

}

#limiter
function limit1 () {
   clear
   echo -e "\E[45;1;37m ⚡ หลวงพี่ · AUTOSCRIPT\E[K\E[0m"
   echo -e "$barra"
   echo -e "\n\033[1;32mเปิดใช้งาน... \033[0m"
   echo ""
   fun_bar 'screen -dmS limiter limiter' 'sleep 3'
   [[ $(grep -wc "limiter" /etc/autostart) = '0' ]] && {
       echo -e "ps x | grep 'limiter' | grep -v 'grep' && echo 'ON' || screen -dmS limiter limiter" >> /etc/autostart
   } || {
       sed -i '/limiter/d' /etc/autostart
	   echo -e "ps x | grep 'limiter' | grep -v 'grep' && echo 'ON' || screen -dmS limiter limiter" >> /etc/autostart
   }
   sleep 3
   menu
}
function limit2 () {
   clear
   echo -e "\E[45;1;37m ⚡ หลวงพี่ · AUTOSCRIPT\E[K\E[0m"
   echo -e "$barra"
   echo ""
   echo -e "\033[1;31mปิดใช้งาน... \033[0m"
   echo ""
   fun_stplimiter () {
      sleep 1
      screen -r -S "limiter" -X quit
      screen -wipe 1>/dev/null 2>/dev/null
      [[ $(grep -wc "limiter" /etc/autostart) != '0' ]] && {
          sed -i '/limiter/d' /etc/autostart
      }
      sleep 1
   }
   fun_bar 'fun_stplimiter' 'sleep 3'
   sleep 3
   menu
}
function limit_ssh () {
[[ $(ps x | grep "limiter"|grep -v grep |wc -l) = '0' ]] && limit1 || limit2
}

# SISTEMA RAPIDO
fun_access () {
echo -e "\033[1;32mหลวงพี่ Commands "
echo ""
echo -e "\033[1;32m"
echo -e "    Command     Description"
echo -e "    -------     -----------"
echo -e "    command     Option menu"
echo -e "    nload       nload"
echo -e "    htop        htop"
echo -e "    system      System info"
echo -e "    clean       Clean system"
echo -e "    speed       Speed Test"
echo -e "    time        Time Asia/Bangkok"
echo ""
}

velocity () {
fun_tst () {
   command -v speedtest-cli >/dev/null 2>&1 || { pip3 install speedtest-cli >/dev/null 2>&1 || pip3 install --break-system-packages speedtest-cli >/dev/null 2>&1 || apt-get install -y speedtest-cli >/dev/null 2>&1; }
   speedtest-cli --simple --secure > $HOME/speed 2>/dev/null || speedtest-cli --simple > $HOME/speed 2>/dev/null
}
echo ""
echo -e "\033[1;35m▍\033[1;36mทดสอบความเร็วเน็ตเซิร์ฟเวอร์\033[0m"
echo ""
rm -f $HOME/speed
fun_tst &
_pid=$!
_f=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧'); _i=0
tput civis 2>/dev/null
while kill -0 $_pid 2>/dev/null; do
   printf '\r  \033[1;35m%s\033[0m \033[1;37mกำลังทดสอบ (ประมาณ 30 วินาที)\033[0m' "${_f[_i++ % 8]}"
   sleep 0.15
done
printf '\r\033[K'
tput cnorm 2>/dev/null
png=$(awk '/^Ping/{print $2" "$3}' $HOME/speed 2>/dev/null)
down=$(awk '/^Download/{print $2" "$3}' $HOME/speed 2>/dev/null)
upl=$(awk '/^Upload/{print $2" "$3}' $HOME/speed 2>/dev/null)
echo -e "$barra"
if [[ -z "$down" ]]; then
   echo -e "\033[1;31m✘ ทดสอบไม่สำเร็จ\033[0m"
   echo -e "\033[1;37mตรวจสอบอินเทอร์เน็ต หรือติดตั้ง speedtest-cli\033[0m"
else
   echo -e "\033[1;36mปิง       \033[1;37m$png\033[0m"
   echo -e "\033[1;36mดาวน์โหลด \033[1;32m$down\033[0m"
   echo -e "\033[1;36mอัปโหลด   \033[1;33m$upl\033[0m"
fi
echo -e "$barra"
rm -f $HOME/speed
}

act_hora () {
fun_prog ()
{
	comando[0]="$1" 
    ${comando[0]}  > /dev/null 2>&1 & 
	tput civis
	echo -ne "\033[1;32m.\033[1;33m.\033[1;31m. \033[1;32m"
    while [ -d /proc/$! ]
	do
		for i in / - \\ \|
		do
			sleep .1
			echo -ne "\e[1D$i"
		done
	done
	tput cnorm
	echo -e "\e[1DOK"
}
echo -ne "\033[1;32m[!] \033[1;33mtimedatectl"; fun_prog 'timedatectl'
echo ""
echo -ne "\033[1;32m[!] \033[1;33mtimedatectl list-timezones"; fun_prog 'timedatectl list-timezones'
echo ""
echo -ne "\033[1;32m[!] \033[1;33mtimedatectl list-timezones  | grep Bangkok"; fun_prog 'timedatectl list-timezones  | grep Bangkok'
echo ""
echo -ne "\033[1;32m[!] \033[1;33mtimedatectl set-timezone Asia/Bangkok"; fun_prog 'timedatectl set-timezone Asia/Bangkok'
echo ""
sleep 1
}

while true $x != "ok"
do

if [[ "$(grep -c "Ubuntu" /etc/issue.net)" = "1" ]]; then
system=$(cut -d' ' -f1 /etc/issue.net)
system+=$(echo ' ')
system+=$(cut -d' ' -f2 /etc/issue.net |awk -F "." '{print $1}')
elif [[ "$(grep -c "Debian" /etc/issue.net)" = "1" ]]; then
system=$(cut -d' ' -f1 /etc/issue.net)
system+=$(echo ' ')
system+=$(cut -d' ' -f3 /etc/issue.net)
else
system=$(cut -d' ' -f1 /etc/issue.net)
fi

on="\033[30;42m ON \033[0m " && off="\033[100;1;37m OFF \033[0m "
[[ `grep -c "^#autoscript" /etc/sysctl.conf` -eq 0 ]] && tcp=$off || tcp=$on
[[ -e /etc/autoscript-torrent ]] && stsf=$(echo -e "\033[30;42m ON \033[0m ") || stsf=$(echo -e "\033[100;1;37m OFF \033[0m ")
stsbot=$(ps x | grep "bot_plus"|grep -v grep > /dev/null && echo -e "\033[30;42m ON \033[0m " || echo -e "\033[100;1;37m OFF \033[0m ")
autm=$(grep "menu;" /etc/profile > /dev/null && echo -e "\033[30;42m ON \033[0m " || echo -e "\033[100;1;37m OFF \033[0m ")
stson=$(ps x | grep "onlineapp"|grep -v grep > /dev/null && echo -e "\033[30;42m ON \033[0m " || echo -e "\033[100;1;37m OFF \033[0m ")
stsl=$(ps x | grep "limiter"|grep -v grep > /dev/null && echo -e "\033[30;42m ON \033[0m " || echo -e "\033[100;1;37m OFF \033[0m ")
stsu=$(ps x | grep "udpvpn"|grep -v grep > /dev/null && echo -e "\033[30;42m ON \033[0m " || echo -e "\033[100;1;37m OFF \033[0m ")
_ons=$(ps -x | grep sshd | grep -v root | grep priv | wc -l)
_expuser=$(cat /etc/AutoScript/Exp 2>/dev/null); [[ -n "$_expuser" ]] || _expuser="0"
[[ -e /etc/openvpn/openvpn-status.log ]] && _onop=$(grep -c "10.8.0" /etc/openvpn/openvpn-status.log) || _onop="0"
[[ -e /etc/default/dropbear ]] && _drp=$(ps aux | grep dropbear | grep -v grep | wc -l) _ondrp=$(($_drp - 1)) || _ondrp="0"
_onli=$(($_ons + $_onop + $_ondrp))
_ram=$(printf ' %-9s' "$(free -h | grep -i mem | awk {'print $2'})")
mb=$(printf '%-8s' "$(free -h | grep Mem | sed 's/\s\+/,/g' | cut -d , -f6)")
_usor=$(printf '%-8s' "$(free -m | awk 'NR==2{printf "%.2f%%", $3*100/$2 }')")
_usop=$(printf '%-1s' "$(top -bn1 | awk '/Cpu/ { cpu = "" 100 - $8 "%" }; END { print cpu }')")
modelo1=$(printf '%-11s' "$(lscpu | grep Arch | sed 's/\s\+/,/g' | cut -d , -f2)")
_core=$(printf '%-1s' "$(grep -c cpu[0-9] /proc/stat)")
_system=$(printf '%-13s' "$system")
_hoje=$(date +'%d/%m/%Y')
_hora=$(printf '%(%H:%M:%S)T')
_onlin=$(printf '%-5s' "$_onli")
_userexp=$(printf '%-5s' "$_expuser")
_tuser=$(awk -F: '$3>=1000 {print $1}' /etc/passwd | grep -v nobody | wc -l)

clear
[[ -n "$CY" ]] || CY=$(wget -qO- --timeout=3 ipinfo.io/country 2>/dev/null); [[ -n "$CY" ]] || CY="--"
_ver=$(sed -n '1p' /bin/version 2>/dev/null); [[ -n "$_ver" ]] || _ver="v1.0.0"
_cpun=$(awk '/^cpu /{print $2+$3+$4+$5+$6+$7+$8, $5+$6}' /proc/stat > /tmp/.cpu1; sleep 0.3; awk '/^cpu /{print $2+$3+$4+$5+$6+$7+$8, $5+$6}' /proc/stat > /tmp/.cpu2; paste -d' ' /tmp/.cpu1 /tmp/.cpu2 | awk '{dt=$3-$1; di=$4-$2; if(dt>0) printf "%d", (dt-di)*100/dt; else print 0}'); _cpun=${_cpun:-0}
_ramn=$(free -m | awk 'NR==2{printf "%d", $3*100/$2 }'); _ramn=${_ramn:-0}
_gauge () {
   local p=${1:-0} n i f="" e="" c
   (( p < 0 )) && p=0; (( p > 100 )) && p=100
   n=$(( (p + 5) / 10 ))
   if (( p < 60 )); then c="\033[1;32m"; elif (( p < 85 )); then c="\033[1;33m"; else c="\033[1;31m"; fi
   for ((i=0; i<10; i++)); do if (( i < n )); then f+="█"; else e+="░"; fi; done
   printf '%b%s\033[1;30m%s\033[0m \033[1;37m%s%%\033[0m' "$c" "$f" "$e" "$p"
}
echo -e "\E[45;1;37m ⚡ หลวงพี่ · AUTOSCRIPT \E[0m\E[45;1;33m $_ver\E[K\E[0m"
echo -e "$barra"
echo -e "\033[1;35m▍\033[1;36mระบบ\033[0m \033[1;37m$(echo $_system)\033[0m \033[0;90m·\033[0m $(uname -m)"
echo -e "\033[1;35m▍\033[1;36mไอพี\033[0m \033[1;37m${IP:-ไม่พบ IP}\033[0m \033[0;90m·\033[0m \033[1;33m$CY\033[0m"
echo -e "\033[1;35m▍\033[1;36mเวลา\033[0m \033[1;37m$_hoje\033[0m \033[0;90m·\033[0m \033[1;37m$_hora\033[0m"
echo -e "\033[1;35m▍\033[1;36mCPU\033[0m $(_gauge "$_cpun") \033[0;90m($_core core)\033[0m"
echo -e "\033[1;35m▍\033[1;36mRAM\033[0m $(_gauge "$_ramn") \033[0;90m($(echo $_ram))\033[0m"
echo -e "$barra"
echo -e "\033[1;32m● ออนไลน์ \033[1;37m$(echo $_onli)\033[0m   \033[1;31m● หมดอายุ \033[1;37m$(echo $_expuser)\033[0m   \033[1;33m● ทั้งหมด \033[1;37m$_tuser\033[0m"
echo -e "$barra"
echo -e "\033[1;35m▍\033[1;36mผู้ใช้ & เครื่องมือ\033[0m"
echo -e "\E[30;46m 01 \E[0m \033[1;37mจัดการผู้ใช้งาน\033[0m"
echo -e "\E[30;46m 02 \E[0m \033[1;37mเครื่องมือเซิร์ฟเวอร์\033[0m"
echo -e "\E[30;46m 03 \E[0m \033[1;37mข้อมูลระบบและบริการ\033[0m"
echo -e "\E[30;46m 04 \E[0m \033[1;37mเมนูเสริม\033[0m"
echo ""
echo -e "\033[1;35m▍\033[1;36mตั้งค่า\033[0m"
echo -e "\E[30;46m 07 \E[0m \033[1;37mจำกัดการเชื่อมต่อ\033[0m $stsl"
echo -e "\E[30;46m 08 \E[0m \033[1;37mเปิดเมนูอัตโนมัติ\033[0m $autm"
echo -e "\E[30;46m 09 \E[0m \033[1;37mติดตั้งบริการ VPN\033[0m"
echo ""
echo -e "\033[1;35m▍\033[1;36mระบบสคริปต์\033[0m"
echo -e "\E[30;46m 05 \E[0m \033[1;37mตรวจสอบอัปเดต\033[0m ${var01:-}"
echo -e "\E[30;46m 06 \E[0m \033[1;31mถอนการติดตั้ง\033[0m"
echo -e "$barra"
echo -e "\E[41;1;37m 00 \E[0m \033[1;37mออกจากเมนู\033[0m"
echo -e "$barra"
echo -ne "\033[1;35m❯ \033[1;37mเลือก \033[0;90m[00-09]\033[1;35m › \033[1;37m"
read -r x

case "$x" in 
   1 | 01)
   clear
   usercodes
   ;;
   2 | 02)
   clear
   ferramentascodes
   ;;
   3 | 03)
   clear
   gestorcodes
   ;;
   4 | 04)
   clear
   utilscodes
   ;;
   5 | 05)
   attscript
   ;;
   6 | 06)
   clear
   delscript
   ;;
   7 | 07)
   limit_ssh
   ;;      
   8 | 08)
   autoexec
   ;;
   9 | 09)
   conexao
   exit
   ;;
   0 | 00)
   echo -e "\033[1;31mออกจากสคริปต์...\033[0m"
   sleep 1
   clear
   exit;
   ;;
   option | command | -c)
   clear
   fun_access
   echo -ne "\n\033[1;35m↵ \033[1;37mแตะ Enter เพื่อกลับเมนู\033[0m"; read
   ;;
   nload)
   clear
   echo -e "\033[1;32mปิดเมนู CLICK CTRL + C\033[1;36m"
   sleep 3
   [[ $(dpkg --get-selections|grep -w "nload"|head -1) ]] || apt-get install nload -y &>/dev/null
   nload
   ;;
   htop)
   clear
   echo -e "\033[1;32mปิดเมนู CLICK CTRL + C\033[1;36m"
   sleep 3
   [[ $(dpkg --get-selections|grep -w "htop"|head -1) ]] || apt-get install htop -y &>/dev/null
   htop
   ;;
   system)
   clear
   detalhes
   echo -ne "\n\033[1;35m↵ \033[1;37mแตะ Enter เพื่อกลับเมนู\033[0m"; read
   ;;
   clean)
   clear
   otimizar
   echo -ne "\n\033[1;35m↵ \033[1;37mแตะ Enter เพื่อกลับเมนู\033[0m"; read
   ;;
   speed)
   clear
   velocity
   echo -ne "\n\033[1;35m↵ \033[1;37mแตะ Enter เพื่อกลับเมนู\033[0m"; read
   ;;
   time)
   clear
   act_hora
   echo -ne "\n\033[1;35m↵ \033[1;37mแตะ Enter เพื่อกลับเมนู\033[0m"; read
   ;;
   *)
   echo -e "\n\033[1;31mไม่พบเมนู !\033[0m"
   sleep 1
esac
done
}
menu
