#!/bin/bash
clear

TCPspeed () {
if [[ `grep -c "^#autoscript" /etc/sysctl.conf` -eq 0 ]]; then
#INSTALA
echo -e "\033[1;36m════════════════════════════════════════════════════\033[0m"
echo -e "\E[44;1;37m             🛠️ ออโต้สคริป โดย หลวงพี่ ✨              \E[0m"
echo -e "\033[1;36m════════════════════════════════════════════════════\033[0m"
echo -e "\033[0m"
read -p "$(echo -ne "\033[1;32mInstall \033[1;31m? \033[1;33m[Y/N]:\033[1;37m") " -e -i y resposta
[[ "$resposta" = @(y|Y) ]] && {
echo "#autoscript" >> /etc/sysctl.conf
echo "net.ipv4.tcp_window_scaling = 1
net.core.rmem_max = 16777216
net.core.wmem_max = 16777216
net.ipv4.tcp_rmem = 4096 87380 16777216
net.ipv4.tcp_wmem = 4096 16384 16777216
net.ipv4.tcp_low_latency = 1
net.ipv4.tcp_slow_start_after_idle = 0" >> /etc/sysctl.conf
sysctl -p /etc/sysctl.conf > /dev/null 2>&1
echo -e "\n\033[1;32m TCP เปิดใช้งานแล้ว ! \033[0m"
sleep 3
utilscodes
} || echo -e "\n\033[1;31m TCP ยกเลิกแล้ว ! \033[0m"
 sleep 3
 utilscodes
 else
#REMOVE
echo -e "\033[1;36m════════════════════════════════════════════════════\033[0m"
echo -e "\E[44;1;37m             🛠️ ออโต้สคริป โดย หลวงพี่ ✨              \E[0m"
echo -e "\033[1;36m════════════════════════════════════════════════════\033[0m"
echo -e "\033[0m"
read -p "$(echo -ne "\033[1;32mRemove \033[1;31m? \033[1;33m[Y/N]:\033[1;37m") " -e -i y resposta
[[ "$resposta" = @(y|Y) ]] && {
grep -v "^#autoscript
net.ipv4.tcp_window_scaling = 1
net.core.rmem_max = 16777216
net.core.wmem_max = 16777216
net.ipv4.tcp_rmem = 4096 87380 16777216
net.ipv4.tcp_wmem = 4096 16384 16777216
net.ipv4.tcp_low_latency = 1
net.ipv4.tcp_slow_start_after_idle = 0" /etc/sysctl.conf > /tmp/syscl && mv -f /tmp/syscl /etc/sysctl.conf
sysctl -p /etc/sysctl.conf > /dev/null 2>&1
echo -e "\n\033[1;31m TCP ปิดใช้งานแล้ว ! \033[0m"
sleep 3
utilscodes
} || echo -e "\n\033[1;31m TCP ยกเลิกแล้ว ! \033[0m"
sleep 3
utilscodes
fi
}
TCPspeed
