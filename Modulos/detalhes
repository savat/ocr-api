#!/bin/bash
_w=$(tput cols 2>/dev/null); [[ "$_w" =~ ^[0-9]+$ ]] || _w=40; (( _w > 60 )) && _w=60; (( _w < 20 )) && _w=20; barra="\033[38;5;177m$(printf '─%.0s' $(seq 1 $_w))\033[0m"
clear
echo -e "\E[48;5;162;1;38;5;231m ⚡ หลวงพี่ · AUTOSCRIPT\E[K\E[0m"
echo -e "$barra"
echo -e "\033[0m"
if [ ! /proc/cpuinfo ]; then echo -e "\033[1;38;5;203mไม่รองรับระบบ    " && echo ""; return 1; fi
if [ ! /etc/issue.net ]; then echo -e "\033[1;38;5;203mไม่รองรับระบบ    " && echo ""; return 1; fi
if [ ! /proc/meminfo ]; then echo -e "\033[1;38;5;203mไม่รองรับระบบ    " && echo ""; return 1; fi

# SISTEMA OPERACIONAL
echo -e "\033[1;38;5;203m• \033[1;38;5;82mระบบปฏิบัติการ\033[1;38;5;203m •\033[0m"
echo ""
[[ ! -e /etc/lsb-release ]] && touch /etc/lsb-release
system=$(cat /etc/issue.net)
codename=$(cat /etc/lsb-release |grep CODENAME |awk -F = {'print $2'})
based=$(cat /etc/*release | grep ID_LIKE | awk -F "=" '{print $2}')
echo -e "\033[1;38;5;203mServerName: \033[1;38;5;231m$(hostname)"
echo -e "\033[1;38;5;203mServer IP: \033[1;38;5;231m$(ip addr | grep inet | grep -v inet6 | grep -v "host lo" | awk '{print $2}' | awk -F "/" '{print $1}')"
[[ "$system" ]] && echo -e "\033[1;38;5;203mSystem: \033[1;38;5;231m$system" || echo -e "\033[1;38;5;203mSystem: \033[1;38;5;231m???"
[[ "$codename" ]] && echo -e "\033[1;38;5;203mCodeName: \033[1;38;5;231m$codename" || echo -e "\033[1;38;5;203mCodeName: \033[1;38;5;231m???"
echo -e "\033[1;38;5;203mKernel: \033[1;38;5;231m$(uname -s)"
echo -e "\033[1;38;5;203mKernel Release: \033[1;38;5;231m$(uname -r)"
[[ "$based" ]] && echo -e "\033[1;38;5;203mBased on: \033[1;38;5;231m$based" || echo -e "\033[1;38;5;203mBased on: \033[1;38;5;231m???"

# PROCESSADOR
echo ""
echo -e "\033[1;38;5;203m• \033[1;38;5;82mหน่วยประมวลผล\033[1;38;5;203m •\033[0m"
echo ""
processor=$(cat /proc/cpuinfo | grep "model name" | uniq | awk -F ":" '{print $2}')
cpus=$(cat /proc/cpuinfo | grep processor | wc -l)
cpucores=$(grep -c cpu[0-9] /proc/stat)
clock=$(lscpu | grep "CPU MHz" | awk '{print $3}')
cache=$(cat /proc/cpuinfo |grep "cache size" |uniq |awk -F : {'print $2'})
uso=$(top -bn1 | awk '/Cpu/ { cpu = "" 100 - $8 "%" }; END { print cpu }')
[[ "$processor" ]] && echo -e "\033[1;38;5;203mProcessor: \033[1;38;5;231m$processor x$cpus" || echo -e "\033[1;38;5;227mProcessor: \033[1;38;5;231m???"
echo -e "\033[1;38;5;203mCore:\033[1;38;5;231m $cpucores"
[[ "$clock" ]] && echo -e "\033[1;38;5;203mOperating Frequency: \033[1;38;5;231m$clock MHz" || echo -e "\033[1;38;5;227mOperating Frequency: \033[1;38;5;231m???"
echo -e "\033[1;38;5;203mMemory Cache:\033[1;38;5;231m$cache"
echo -e "\033[1;38;5;203mArchitecture: \033[1;38;5;231m$(uname -m)"
echo -e "\033[1;38;5;203mUsed: \033[37m$uso"

# MEMORIA RAM
echo ""
echo -e "\033[1;38;5;203m• \033[1;38;5;82mหน่วยความจำ\033[1;38;5;203m •\033[0m"
echo ""
totalram=$(free | grep Mem | awk '{print $2}')
usedram=$(free | grep Mem | awk '{print $3}')
freeram=$(free | grep Mem | awk '{print $4}')
usoram=$(free -m | awk 'NR==2{printf "%.2f%%\t\t", $3*100/$2 }')
swapram=$(cat /proc/meminfo | grep SwapTotal | awk '{print $2}')
echo -e "\033[1;38;5;203mTotal: \033[1;38;5;231m$(($totalram / 1024))"
echo -e "\033[1;38;5;203mIn use: \033[1;38;5;231m$(($usedram / 1024))"
echo -e "\033[1;38;5;203mLibre: \033[1;38;5;231m$(($freeram / 1024))"
echo -e "\033[1;38;5;203mUsed: \033[37m$usoram"
echo -e "\033[1;38;5;203mSwap: \033[1;38;5;231m$(($swapram / 1024))MB"

# TEMPO ONLINE
echo ""
echo -e "\033[1;38;5;203m• \033[1;38;5;82mเวลาทำงาน\033[1;38;5;203m •\033[0m"
echo ""
echo -e "\033[1;38;5;203mTime Online: \033[1;38;5;231m$(uptime)"

# SERVICIOS EN FUNCIONAMIENTO
echo ""
echo -e "\033[1;38;5;203m• \033[1;38;5;82mพอร์ตที่เปิดใช้งาน\033[1;38;5;203m •\033[0m"
echo ""
PT=$(lsof -V -i tcp -P -n | grep -v "ESTABLISHED" |grep -v "COMMAND" | grep "LISTEN")
for porta in `echo -e "$PT" | cut -d: -f2 | cut -d' ' -f1 | uniq`; do
    svcs=$(echo -e "$PT" | grep -w "$porta" | awk '{print $1}' | uniq)
    echo -e "\033[1;38;5;213m▸ \033[1;38;5;227m$svcs \033[38;5;247m: \033[1;38;5;231m$porta\033[0m"
done