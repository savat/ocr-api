#!/bin/bash
clear
echo -e "\033[1;31m════════════════════════════════════════════════════\033[0m"
echo -e "\E[44;1;37m             ⇱ ออโต้สคริป โดย หลวงพี่ ⇲              \E[0m"
echo -e "\033[1;31m════════════════════════════════════════════════════\033[0m"
echo -e "\033[0m"
if [ ! /proc/cpuinfo ]; then echo -e "\033[1;31mไม่รองรับระบบ    " && echo ""; return 1; fi
if [ ! /etc/issue.net ]; then echo -e "\033[1;31mไม่รองรับระบบ    " && echo ""; return 1; fi
if [ ! /proc/meminfo ]; then echo -e "\033[1;31mไม่รองรับระบบ    " && echo ""; return 1; fi

# SISTEMA OPERACIONAL
echo -e "\033[1;31m• \033[1;32mระบบปฏิบัติการ\033[1;31m •\033[0m"
echo ""
[[ ! -e /etc/lsb-release ]] && touch /etc/lsb-release
system=$(cat /etc/issue.net)
codename=$(cat /etc/lsb-release |grep CODENAME |awk -F = {'print $2'})
based=$(cat /etc/*release | grep ID_LIKE | awk -F "=" '{print $2}')
echo -e "\033[1;31mServerName: \033[1;37m$(hostname)"
echo -e "\033[1;31mServer IP: \033[1;37m$(ip addr | grep inet | grep -v inet6 | grep -v "host lo" | awk '{print $2}' | awk -F "/" '{print $1}')"
[[ "$system" ]] && echo -e "\033[1;31mSystem: \033[1;37m$system" || echo -e "\033[1;31mSystem: \033[1;37m???"
[[ "$codename" ]] && echo -e "\033[1;31mCodeName: \033[1;37m$codename" || echo -e "\033[1;31mCodeName: \033[1;37m???"
echo -e "\033[1;31mKernel: \033[1;37m$(uname -s)"
echo -e "\033[1;31mKernel Release: \033[1;37m$(uname -r)"
[[ "$based" ]] && echo -e "\033[1;31mBased on: \033[1;37m$based" || echo -e "\033[1;31mBased on: \033[1;37m???"

# PROCESSADOR
echo ""
echo -e "\033[1;31m• \033[1;32mหน่วยประมวลผล\033[1;31m •\033[0m"
echo ""
processor=$(cat /proc/cpuinfo | grep "model name" | uniq | awk -F ":" '{print $2}')
cpus=$(cat /proc/cpuinfo | grep processor | wc -l)
cpucores=$(grep -c cpu[0-9] /proc/stat)
clock=$(lscpu | grep "CPU MHz" | awk '{print $3}')
cache=$(cat /proc/cpuinfo |grep "cache size" |uniq |awk -F : {'print $2'})
uso=$(top -bn1 | awk '/Cpu/ { cpu = "" 100 - $8 "%" }; END { print cpu }')
[[ "$processor" ]] && echo -e "\033[1;31mProcessor: \033[1;37m$processor x$cpus" || echo -e "\033[1;33mProcessor: \033[1;37m???"
echo -e "\033[1;31mCore:\033[1;37m $cpucores"
[[ "$clock" ]] && echo -e "\033[1;31mOperating Frequency: \033[1;37m$clock MHz" || echo -e "\033[1;33mOperating Frequency: \033[1;37m???"
echo -e "\033[1;31mMemory Cache:\033[1;37m$cache"
echo -e "\033[1;31mArchitecture: \033[1;37m$(uname -m)"
echo -e "\033[1;31mUsed: \033[37m$uso"

# MEMORIA RAM
echo ""
echo -e "\033[1;31m• \033[1;32mหน่วยความจำ\033[1;31m •\033[0m"
echo ""
totalram=$(free | grep Mem | awk '{print $2}')
usedram=$(free | grep Mem | awk '{print $3}')
freeram=$(free | grep Mem | awk '{print $4}')
usoram=$(free -m | awk 'NR==2{printf "%.2f%%\t\t", $3*100/$2 }')
swapram=$(cat /proc/meminfo | grep SwapTotal | awk '{print $2}')
echo -e "\033[1;31mTotal: \033[1;37m$(($totalram / 1024))"
echo -e "\033[1;31mIn use: \033[1;37m$(($usedram / 1024))"
echo -e "\033[1;31mLibre: \033[1;37m$(($freeram / 1024))"
echo -e "\033[1;31mUsed: \033[37m$usoram"
echo -e "\033[1;31mSwap: \033[1;37m$(($swapram / 1024))MB"

# TEMPO ONLINE
echo ""
echo -e "\033[1;31m• \033[1;32mเวลาทำงาน\033[1;31m •\033[0m"
echo ""
echo -e "\033[1;31mTime Online: \033[1;37m$(uptime)"

# SERVICIOS EN FUNCIONAMIENTO
echo ""
echo -e "\033[1;31m• \033[1;32mพอร์ตที่เปิดใช้งาน\033[1;31m •\033[0m"
echo ""
PT=$(lsof -V -i tcp -P -n | grep -v "ESTABLISHED" |grep -v "COMMAND" | grep "LISTEN")
for porta in `echo -e "$PT" | cut -d: -f2 | cut -d' ' -f1 | uniq`; do
    svcs=$(echo -e "$PT" | grep -w "$porta" | awk '{print $1}' | uniq)
    echo -e "\033[1;32mService: \033[1;31m$svcs \033[1;32mPort: \033[1;37m$porta"
done