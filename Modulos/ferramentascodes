#onlineapp
function onapp1 () {
   clear
   echo -e "\033[1;31m════════════════════════════════════════════════════\033[0m"
   echo -e "\E[44;1;37m             ⇱ ออโต้สคริป โดย หลวงพี่ ⇲              \E[0m"
   echo -e "\033[1;31m════════════════════════════════════════════════════\033[0m"
   echo -e "\n\033[1;32mกำลังติดตั้งระบบ... \033[0m"
   echo ""
   apt install apache2 -y > /dev/null 2>&1
   service apache2 restart
   rm -rf /var/www/html/server >/dev/null 2>&1
   mkdir /var/www/html/server >/dev/null 2>&1
   fun_bar 'screen -dmS onlineapp onlineapp' 'sleep 3'
   [[ $(grep -wc "onlineapp" /etc/autostart) = '0' ]] && {
       echo -e "ps x | grep 'onlineapp' | grep -v 'grep' && echo 'ON' || screen -dmS onlineapp onlineapp" >> /etc/autostart
   } || {
       sed -i '/onlineapp/d' /etc/autostart
	   echo -e "ps x | grep 'onlineapp' | grep -v 'grep' && echo 'ON' || screen -dmS onlineapp onlineapp" >> /etc/autostart
   }
   IP=$(wget -qO- ipv4.icanhazip.com) >/dev/null 2>&1
   echo -e "\n\033[1;32m ระบบตรวจสอบผู้ใช้งานผ่านเว็บไซต์ ถูกเปิดใช้งานแล้ว !\033[0m"
   echo -e "\033[1;31m \033[1;33mติดตั้งเรียบร้อยแล้ว URL ตามนี้    \033[0m"
   echo -e " http://$IP:81/server/online"
   echo -e " http://$IP:81/server/online.json"
   echo -e " http://$IP:81/server/online_app"
   echo -e " http://$IP:81/server/online_app.json"
   echo -ne "\n\033[1;31mENTER \033[1;33mBack \033[1;32mMENU!\033[0m"; read
   ferramentascodes
}
function onapp2 () {
   clear
   echo -e "\033[1;31m════════════════════════════════════════════════════\033[0m"
   echo -e "\E[44;1;37m             ⇱ ออโต้สคริป โดย หลวงพี่ ⇲              \E[0m"
   echo -e "\033[1;31m════════════════════════════════════════════════════\033[0m"
   echo ""
   echo -e "\033[1;32mปิดใช้งาน... \033[0m"
   echo ""
   fun_stponlineapp () {
      sleep 1
      screen -r -S "onlineapp" -X quit
      screen -wipe 1>/dev/null 2>/dev/null
      [[ $(grep -wc "onlineapp" /etc/autostart) != '0' ]] && {
          sed -i '/onlineapp/d' /etc/autostart
      }
      sleep 1
   }
   fun_bar 'fun_stponlineapp' 'sleep 3'
   rm -rf /var/www/html/server >/dev/null 2>&1
   echo -e "\n\033[1;31m ระบบตรวจสอบผู้ใช้งานผ่านเว็บไซต์ ถูกปิดใช้งานแล้ว !\033[0m"
   sleep 3
   ferramentascodes
}
function onapp_ssh () {
[[ $(ps x | grep "onlineapp"|grep -v grep |wc -l) = '0' ]] && onapp1 || onapp2
}
##



while true $x != "ok"
do

if [[ "$(grep -c "Ubuntu" /etc/issue.net)" = "1" ]]; then
system=$(cut -d' ' -f1 /etc/issue.net)
system+=$(echo ' ')
system+=$(cut -d' ' -f2 /etc/issue.net |awk -F "." '{print $1}')
elif [[ "$(grep -c "Debian" /etc/issue.net)" = "1" ]]; then
system=$(cut -d' ' -f1 /etc/issue.net)
system+=$(echo ' ')
system+=$(cut -d' ' -f3 /etc/issue.net)
else
system=$(cut -d' ' -f1 /etc/issue.net)
fi

on="\033[1;32m◉ " && off="\033[1;31m○ "
[[ `grep -c "^#autoscript" /etc/sysctl.conf` -eq 0 ]] && tcp=$off || tcp=$on
[[ -e /etc/autoscript-torrent ]] && stsf=$(echo -e "\033[1;32m◉ ") || stsf=$(echo -e "\033[1;31m○ ")
stsbot=$(ps x | grep "bot_plus"|grep -v grep > /dev/null && echo -e "\033[1;32m◉ " || echo -e "\033[1;31m○ ")
autm=$(grep "menu;" /etc/profile > /dev/null && echo -e "\033[1;32m◉ " || echo -e "\033[1;31m○ ")
stson=$(ps x | grep "onlineapp"|grep -v grep > /dev/null && echo -e "\033[1;32m◉ " || echo -e "\033[1;31m○ ")
stsl=$(ps x | grep "limiter"|grep -v grep > /dev/null && echo -e "\033[1;32m◉ " || echo -e "\033[1;31m○ ")
stsu=$(ps x | grep "udpvpn"|grep -v grep > /dev/null && echo -e "\033[1;32m◉ " || echo -e "\033[1;31m○ ")
_ons=$(ps -x | grep sshd | grep -v root | grep priv | wc -l)
[[ "$(cat /etc/AutoScript/Exp)" != "" ]] && _expuser=$(cat /etc/AutoScript/Exp) || _expuser="0"
[[ -e /etc/openvpn/openvpn-status.log ]] && _onop=$(grep -c "10.8.0" /etc/openvpn/openvpn-status.log) || _onop="0"
[[ -e /etc/default/dropbear ]] && _drp=$(ps aux | grep dropbear | grep -v grep | wc -l) _ondrp=$(($_drp - 1)) || _ondrp="0"
_onli=$(($_ons + $_onop + $_ondrp))
_ram=$(printf ' %-9s' "$(free -h | grep -i mem | awk {'print $2'})")
mb=$(printf '%-8s' "$(free -h | grep Mem | sed 's/\s\+/,/g' | cut -d , -f6)")
_usor=$(printf '%-8s' "$(free -m | awk 'NR==2{printf "%.2f%%", $3*100/$2 }')")
_usop=$(printf '%-1s' "$(top -bn1 | awk '/Cpu/ { cpu = "" 100 - $8 "%" }; END { print cpu }')")
modelo1=$(printf '%-11s' "$(lscpu | grep Arch | sed 's/\s\+/,/g' | cut -d , -f2)")
_core=$(printf '%-1s' "$(grep -c cpu[0-9] /proc/stat)")
_system=$(printf '%-13s' "$system")
_hoje=$(date +'%d/%m/%Y')
_hora=$(printf '%(%H:%M:%S)T')
_onlin=$(printf '%-5s' "$_onli")
_userexp=$(printf '%-5s' "$_expuser")
_tuser=$(awk -F: '$3>=1000 {print $1}' /etc/passwd | grep -v nobody | wc -l)

clear
echo -e "$barra"
echo -e "\E[44;1;37m             ⇱ ออโต้สคริป โดย หลวงพี่ ⇲              \E[0m"
echo -e "$barra"
echo -e "\033[1;31m[\033[1;36m01\033[1;31m] \033[1;37m• \033[1;33mเปิด/ปิด แสดงจำนวนเชื่อมต่อเว็บไซต์ $stson"
echo -e "\033[1;31m[\033[1;36m02\033[1;31m] \033[1;37m• \033[1;33mแก้ไขคอนฟิก แสดงจำนวนเชื่อมต่อเว็บไซต์      "
echo -e "\033[1;31m[\033[1;36m03\033[1;31m] \033[1;37m• \033[1;33mทดสอบความเร็วอินเทอร์เน็ต     "                 
echo -e "\033[1;31m[\033[1;36m04\033[1;31m] \033[1;37m• \033[1;33mเพิ่มแรมเซิร์ฟเวอร์     "
echo -e "\033[1;31m[\033[1;36m00\033[1;31m] \033[1;37m• \033[1;33mย้อนกลับ? \033[1;32m<\033[1;33m<\033[1;31m<"
echo -e "$barra"
echo -ne "\033[1;32mSelect Menu \033[1;33m?\033[1;31m?\033[1;37m : "; read x

case "$x" in 
   1 | 01)
   #botssh
   onapp_ssh
   ;;
   2 | 02)
   clear
   nano /bin/onlineapp
   echo -ne "\n\033[1;31mENTER \033[1;33mBack \033[1;32mMENU!\033[0m"; read
   ;;
   3 | 03)
   clear
   velocity
   echo -ne "\n\033[1;31mENTER \033[1;33mBack \033[1;32mMENU!\033[0m"; read
   ;;
   4 | 04)
   clear
   swapmemory
   echo -ne "\n\033[1;31mENTER \033[1;33mBack \033[1;32mMENU!\033[0m"; read
   ;;   
   0 | 00)
   menu
   exit;
   ;;
   *)
   echo -e "\n\033[1;31mเมนูไม่ถูกต้อง !\033[0m"
   sleep 1
esac
done
}
