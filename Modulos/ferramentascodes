#!/bin/bash
_w=$(tput cols 2>/dev/null); [[ "$_w" =~ ^[0-9]+$ ]] || _w=40; (( _w > 60 )) && _w=60; (( _w < 20 )) && _w=20; barra="\033[38;5;177m$(printf '─%.0s' $(seq 1 $_w))\033[0m"
IP=$(cat /etc/IP)
x="ok"

fun_bar () {
comando[0]="$1"
comando[1]="$2"
 (
[[ -e $HOME/fim ]] && rm $HOME/fim
${comando[0]} -y > /dev/null 2>&1
${comando[1]} -y > /dev/null 2>&1
touch $HOME/fim
 ) > /dev/null 2>&1 &
 tput civis
 local _f=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧') _i=0
 while [[ ! -e $HOME/fim ]]; do
   printf '\r  \033[1;38;5;213m%s\033[0m \033[1;38;5;231mกำลังทำงาน\033[0m \033[38;5;247m…\033[0m' "${_f[_i++ % 8]}"
   sleep 0.12
 done
 rm -f $HOME/fim
 printf '\r\033[K  \033[1;38;5;82m✔\033[0m \033[1;38;5;231mเสร็จแล้ว\033[0m\n'
 tput cnorm
}

ferramentascodes ()
{
velocity () {
fun_tst () {
   : > $HOME/speed
   _p=$(ping -c 4 -q 1.1.1.1 2>/dev/null | awk -F'/' '/^rtt|^round-trip/{printf "%.1f", $5}')
   _d=$(curl -s -m 25 -o /dev/null -w '%{speed_download}' "https://speed.cloudflare.com/__down?bytes=50000000" 2>/dev/null)
   _u=$(head -c 20000000 /dev/zero | curl -s -m 25 -o /dev/null -w '%{speed_upload}' -X POST --data-binary @- "https://speed.cloudflare.com/__up" 2>/dev/null)
   if awk -v d="${_d:-0}" 'BEGIN{exit !(d>0)}'; then
      [[ -n "$_p" ]] && echo "Ping: $_p ms" >> $HOME/speed
      awk -v d="$_d" 'BEGIN{printf "Download: %.2f Mbit/s\n", d*8/1000000}' >> $HOME/speed
      awk -v u="${_u:-0}" 'BEGIN{printf "Upload: %.2f Mbit/s\n", u*8/1000000}' >> $HOME/speed
   elif command -v speedtest-cli >/dev/null 2>&1; then
      speedtest-cli --simple > $HOME/speed 2>/dev/null
   fi
}
echo -e "\E[48;5;162;1;38;5;231m ⚡ หลวงพี่ · AUTOSCRIPT\E[K\E[0m"
echo -e "$barra"
echo ""
echo -e "\033[1;38;5;213m▍\033[1;38;5;51mทดสอบความเร็วเน็ตเซิร์ฟเวอร์\033[0m"
echo ""
rm -f $HOME/speed
fun_tst &
_pid=$!
_f=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧'); _i=0
tput civis 2>/dev/null
while kill -0 $_pid 2>/dev/null; do
   printf '\r  \033[1;38;5;213m%s\033[0m \033[1;38;5;231mกำลังทดสอบ (ประมาณ 30 วินาที)\033[0m' "${_f[_i++ % 8]}"
   sleep 0.15
done
printf '\r\033[K'
tput cnorm 2>/dev/null
png=$(awk '/^Ping/{print $2" "$3}' $HOME/speed 2>/dev/null)
down=$(awk '/^Download/{print $2" "$3}' $HOME/speed 2>/dev/null)
upl=$(awk '/^Upload/{print $2" "$3}' $HOME/speed 2>/dev/null)
echo -e "$barra"
if [[ -z "$down" ]]; then
   echo -e "\033[1;38;5;203m✘ ทดสอบไม่สำเร็จ\033[0m"
   echo -e "\033[1;38;5;231mตรวจสอบอินเทอร์เน็ต หรือติดตั้ง speedtest-cli\033[0m"
else
   echo -e "\033[1;38;5;51mปิง       \033[1;38;5;231m${png:--}\033[0m"
   echo -e "\033[1;38;5;51mดาวน์โหลด \033[1;38;5;82m$down\033[0m"
   echo -e "\033[1;38;5;51mอัปโหลด   \033[1;38;5;227m$upl\033[0m"
fi
echo -e "$barra"
rm -f $HOME/speed
}

#onlineapp
function onapp1 () {
   clear
   echo -e "\E[48;5;162;1;38;5;231m ⚡ หลวงพี่ · AUTOSCRIPT\E[K\E[0m"
   echo -e "$barra"
   echo -e "\n\033[1;38;5;82mกำลังติดตั้งระบบ... \033[0m"
   echo ""
   apt install apache2 -y > /dev/null 2>&1
   service apache2 restart
   rm -rf /var/www/html/server >/dev/null 2>&1
   mkdir /var/www/html/server >/dev/null 2>&1
   fun_bar 'screen -dmS onlineapp onlineapp' 'sleep 3'
   [[ $(grep -wc "onlineapp" /etc/autostart) = '0' ]] && {
       echo -e "ps x | grep 'onlineapp' | grep -v 'grep' && echo 'ON' || screen -dmS onlineapp onlineapp" >> /etc/autostart
   } || {
       sed -i '/onlineapp/d' /etc/autostart
	   echo -e "ps x | grep 'onlineapp' | grep -v 'grep' && echo 'ON' || screen -dmS onlineapp onlineapp" >> /etc/autostart
   }
   IP=$(wget -qO- ipv4.icanhazip.com) >/dev/null 2>&1
   echo -e "\n\033[1;38;5;82m ระบบตรวจสอบผู้ใช้งานผ่านเว็บไซต์ ถูกเปิดใช้งานแล้ว !\033[0m"
   echo -e "\033[1;38;5;203m \033[1;38;5;227mติดตั้งเรียบร้อยแล้ว URL ตามนี้    \033[0m"
   echo -e " http://$IP/server/online"
   echo -e " http://$IP/server/online.json"
   echo -e " http://$IP/server/online_app"
   echo -e " http://$IP/server/online_app.json"
   echo -ne "\n\033[1;38;5;213m↵ \033[1;38;5;231mแตะ Enter เพื่อกลับเมนู\033[0m"; read
   ferramentascodes
}
function onapp2 () {
   clear
   echo -e "\E[48;5;162;1;38;5;231m ⚡ หลวงพี่ · AUTOSCRIPT\E[K\E[0m"
   echo -e "$barra"
   echo ""
   echo -e "\033[1;38;5;82mปิดใช้งาน... \033[0m"
   echo ""
   fun_stponlineapp () {
      sleep 1
      screen -r -S "onlineapp" -X quit
      screen -wipe 1>/dev/null 2>/dev/null
      [[ $(grep -wc "onlineapp" /etc/autostart) != '0' ]] && {
          sed -i '/onlineapp/d' /etc/autostart
      }
      sleep 1
   }
   fun_bar 'fun_stponlineapp' 'sleep 3'
   rm -rf /var/www/html/server >/dev/null 2>&1
   echo -e "\n\033[1;38;5;203m ระบบตรวจสอบผู้ใช้งานผ่านเว็บไซต์ ถูกปิดใช้งานแล้ว !\033[0m"
   sleep 3
   ferramentascodes
}
function onapp_ssh () {
[[ $(ps x | grep "onlineapp"|grep -v grep |wc -l) = '0' ]] && onapp1 || onapp2
}
