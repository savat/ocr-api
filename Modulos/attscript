#!/bin/bash
clear

fun_bar () {
comando[0]="$1"
comando[1]="$2"
 (
[[ -e $HOME/fim ]] && rm $HOME/fim
${comando[0]} > /dev/null 2>&1
${comando[1]} > /dev/null 2>&1
touch $HOME/fim
 ) > /dev/null 2>&1 &
 tput civis
echo -ne "   \033[1;33mโปรดรอสักครู่ \033[1;37m- \033[1;33m["
while true; do
   for((i=0; i<18; i++)); do
   echo -ne "\033[1;31m#"
   sleep 0.1s
   done
   [[ -e $HOME/fim ]] && rm $HOME/fim && break
   echo -e "\033[1;33m]"
   sleep 1s
   tput cuu1
   tput dl1
   echo -ne "   \033[1;33mโปรดรอสักครู่ \033[1;37m- \033[1;33m["
done
echo -e "\033[1;33m]\033[1;37m -\033[1;32m OK !\033[1;37m"
tput cnorm
}

fun_atts () {
  [[ -e /home/version ]] && rm /home/version
  [[ -e /tmp/att ]] && rm /tmp/att
	wget -c -P /home https://raw.githubusercontent.com/savat/ocr-api/main/Install/version
	[[ -f "/home/version" ]] && mv /home/version /tmp/att
	[[ ! -e /bin/version ]] && rm -rf /bin/menu
} > /dev/null 2>&1
echo -e "\033[1;31m════════════════════════════════════════════════════\033[0m"
echo -e "\E[44;1;37m             ⇱ ออโต้สคริป โดย หลวงพี่ ⇲              \E[0m"
echo -e "\033[1;31m════════════════════════════════════════════════════\033[0m"
echo ""
echo -e "                            \033[1;31mหลวงพี่      \033[1;36m"
echo -e "   LUANGPHI" | figlet
echo " "
echo -e "   \033[1;32mกำลังตรวจสอบการอัปเดต   \033[0m\n"
fun_bar 'fun_atts'
[[ ! -f "/tmp/att" ]] && {
	echo -e "\n\033[1;31m ไม่สามารถอัปเดตได้หรือเป็นเวอร์ชันล่าสุดแล้ว   \n"
	echo -ne "\033[1;31m ENTER \033[1;33mBack \033[1;32mMENU!\033[0m"; read
	menu
}

echo " "

vrs1=$(sed -n '1 p' /bin/version| sed -e 's/[^0-9]//ig')
vrs2=$(sed -n '1 p' /tmp/att | sed -e 's/[^0-9]//ig')

[[ "$vrs1" == "$vrs2" ]] && {
  echo -e " \033[1;36m  สคริปต์ได้รับการอัปเดตแล้ว!\033[1;32m\n"
  rm /tmp/att > /dev/null 2>&1
  echo -e " \033[1;33m  มีปัญหาอื่นๆ \033[1;31m(ติดต่อ\033[1;31m)\033[1;33m: \033[1;32mหลวงพี่   \033[0m \n"
  echo -ne " \033[1;31m ENTER \033[1;33mBack \033[1;32mMENU!\033[0m"; read
  menu
} || {
  echo -e "  \033[1;36m ตรวจพบการอัปเดตใหม่!\033[1;33m\n"
  echo -e " \033[1;33m  มีปัญหาอื่นๆ \033[1;31m(ติดต่อ\033[1;31m)\033[1;33m: \033[1;32mหลวงพี่   \033[0m \n"
  echo -e "  \033[1;32m รายละเอียดอัปเดต:\033[0m\n"
  while read linha; do
    echo -e "  \033[1;37m- \033[1;33m$linha"
  done < "/tmp/att"
  echo " "
  echo -ne "  \033[1;32mUpdate \033[1;31m? \033[1;33m[Y/N]:\033[1;37m "; read res
  if [[ "$res" = y || "$res" = Y ]];then
    echo -e "\n\033[1;32m  กำลังเริ่มการอัปเดต..."
    sleep 3
    wget -q https://raw.githubusercontent.com/savat/ocr-api/main/autoscript.sh > /dev/null 2>&1
    chmod +x autoscript.sh
    ./autoscript.sh
    clear
    echo -e "\033[1;32mอัปเดตเรียบร้อยแล้ว   \033[0m\n"
    rm /tmp/att > /dev/null 2>&1
    echo -ne "\033[1;31mENTER \033[1;33mBack \033[1;32mMENU!\033[0m"; read
    menu
  else
    menu
  fi
}

