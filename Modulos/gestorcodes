velocity () {
fun_tst () {
   : > $HOME/speed
   _p=$(ping -c 4 -q 1.1.1.1 2>/dev/null | awk -F'/' '/^rtt|^round-trip/{printf "%.1f", $5}')
   _d=$(curl -s -m 25 -o /dev/null -w '%{speed_download}' "https://speed.cloudflare.com/__down?bytes=50000000" 2>/dev/null)
   _u=$(head -c 20000000 /dev/zero | curl -s -m 25 -o /dev/null -w '%{speed_upload}' -X POST --data-binary @- "https://speed.cloudflare.com/__up" 2>/dev/null)
   if awk -v d="${_d:-0}" 'BEGIN{exit !(d>0)}'; then
      [[ -n "$_p" ]] && echo "Ping: $_p ms" >> $HOME/speed
      awk -v d="$_d" 'BEGIN{printf "Download: %.2f Mbit/s\n", d*8/1000000}' >> $HOME/speed
      awk -v u="${_u:-0}" 'BEGIN{printf "Upload: %.2f Mbit/s\n", u*8/1000000}' >> $HOME/speed
   elif command -v speedtest-cli >/dev/null 2>&1; then
      speedtest-cli --simple > $HOME/speed 2>/dev/null
   fi
}
echo ""
echo -e "\033[1;38;5;213m▍\033[1;38;5;51mทดสอบความเร็วเน็ตเซิร์ฟเวอร์\033[0m"
echo ""
rm -f $HOME/speed
fun_tst &
_pid=$!
_f=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧'); _i=0
tput civis 2>/dev/null
while kill -0 $_pid 2>/dev/null; do
   printf '\r  \033[1;38;5;213m%s\033[0m \033[1;38;5;231mกำลังทดสอบ (ประมาณ 30 วินาที)\033[0m' "${_f[_i++ % 8]}"
   sleep 0.15
done
printf '\r\033[K'
tput cnorm 2>/dev/null
png=$(awk '/^Ping/{print $2" "$3}' $HOME/speed 2>/dev/null)
down=$(awk '/^Download/{print $2" "$3}' $HOME/speed 2>/dev/null)
upl=$(awk '/^Upload/{print $2" "$3}' $HOME/speed 2>/dev/null)
