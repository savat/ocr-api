#!/bin/bash
_w=$(tput cols 2>/dev/null); [[ "$_w" =~ ^[0-9]+$ ]] || _w=40; (( _w > 60 )) && _w=60; (( _w < 20 )) && _w=20; barra="\033[38;5;177m$(printf '─%.0s' $(seq 1 $_w))\033[0m"
echo -e "\E[48;5;162;1;38;5;231m ⚡ หลวงพี่ · AUTOSCRIPT\E[K\E[0m"
echo -e "$barra"
echo -e "\033[0m"
echo -e "\033[1;38;5;227mรายชื่อทั้งหมด:\033[0m "
echo ""
tput setaf 7 ; tput bold 
database="/root/username.db"
list_user=$(awk -F: '$3>=1000 {print $1}' /etc/passwd | grep -v nobody)
i=0
i=0
unset _userPass
while read user; do
	i=$(expr $i + 1)
	_oP=$i
	[[ $i == [1-9] ]] && i=0$i && oP+=" 0$i"
	expire="$(chage -l $user | grep -E "Account expires" | cut -d ' ' -f3-)"
	if [[ $expire == "never" ]]
	then
		echo -e "\E[48;5;45;38;5;16m $i \E[0m \033[1;38;5;231m- \033[1;38;5;82m$user        \033[1;38;5;227m00/00/0000   \033[1;38;5;82mไม่จำกัดเวลา\033[0m"
	else
		databr="$(date -d "$expire" +"%Y%m%d")"
		hoje="$(date -d today +"%Y%m%d")"
		if [ $hoje -ge $databr ]
		then
			_user=$(echo -e "\E[48;5;45;38;5;16m $i \E[0m \033[1;38;5;231m- \033[1;38;5;82m$user\033[1;38;5;231m")
			datanormal="$(echo -e "\033[1;38;5;203m$(date -d"$expire" '+%d/%m/%Y')")"
			expired=$(echo -e "\033[1;38;5;203mหมดอายุ    \033[0m")
			printf '%-62s%-20s%s\n' "$_user" "$datanormal" "$expired"
			echo "exp" > /tmp/exp
		else
			_user=$(echo -e "\E[48;5;45;38;5;16m $i \E[0m \033[1;38;5;231m- \033[1;38;5;82m$user\033[1;38;5;231m")
			datanormal="$(echo -e "\033[1;38;5;227m$(date -d"$expire" '+%d/%m/%Y')")"
			ative=$(echo -e "\033[1;38;5;82mใช้งานได้    \033[0m")
			printf '%-62s%-20s%s\n' "$_user" "$datanormal" "$ative"
		fi
	fi
	_userPass+="\n${_oP}:${user}"
done <<< "${list_user}"
tput sgr0
echo ""
if [ -a /tmp/exp ]
then
	rm /tmp/exp
fi
num_user=$(awk -F: '$3>=1000 {print $1}' /etc/passwd | grep -v nobody | wc -l)
echo -ne "\033[1;38;5;82mชื่อผู้ใช้ \033[1;38;5;227m[\033[1;38;5;51m1\033[1;38;5;227m-\033[1;38;5;51m$num_user\033[1;38;5;227m]\033[1;38;5;231m: " ; read option
if [[ -z $option ]]
then
	echo ""
	tput setaf 7 ; tput setab 1 ; tput bold ; echo "ข้อผิดพลาด ชื่อผู้ใช้งานว่างเปล่าหรือไม่ถูกต้อง ! " ; tput sgr0
	exit 1
fi
usuario=$(echo -e "${_userPass}" | grep -E "\b$option\b" | cut -d: -f2)
if [[ -z $usuario ]]
then
	echo ""
	tput setaf 7 ; tput setab 1 ; tput bold ; echo "ข้อผิดพลาด ชื่อผู้ใช้งานว่างเปล่าหรือไม่ถูกต้อง !!! " ; tput sgr0
	echo ""
	exit 1
else
	if [[ `grep -c /$usuario: /etc/passwd` -ne 0 ]]
	then
	    echo ""
	    echo -e "\033[1;38;5;203mเช่น:\033[1;38;5;227m(\033[1;38;5;82mวันที่:\033[1;38;5;231m วัน/เดือน/ปี \033[1;38;5;227mหรือ \033[1;38;5;82mเวลา: \033[1;38;5;231m30\033[1;38;5;227m)"
	    echo ""
	    echo -ne "\033[1;38;5;82mวันที่ใหม่ \033[1;38;5;227m$usuario: \033[1;38;5;231m"; read inputdate
	    if [[ "$(echo -e "$inputdate" | grep -c "/")" = "0" ]]; then 
	    	udata=$(date "+%d/%m/%Y" -d "+$inputdate days")
	    	sysdate="$(echo "$udata" | awk -v FS=/ -v OFS=- '{print $3,$2,$1}')"
	    else
	    	udata=$(echo -e "$inputdate")
	    	sysdate="$(echo "$inputdate" | awk -v FS=/ -v OFS=- '{print $3,$2,$1}')"
	    fi
		if (date "+%Y-%m-%d" -d "$sysdate" > /dev/null  2>&1)
		then
			if [[ -z $inputdate ]]
			then
				echo ""
				tput setaf 7 ; tput setab 0 ; tput bold ;	echo "คุณป้อนวันที่ที่ไม่ถูกต้องหรือไม่มีอยู่จริง !" ; echo "ป้อนวันที่ที่ถูกต้องในรูปแบบ วัน/เดือน/ปี " ; echo "ตัวอย่าง: 21/04/2023" ; tput sgr0 ; tput sgr0
				echo ""
				exit 1	
			else
				if (echo $inputdate | egrep [^a-zA-Z] &> /dev/null)
				then
					today="$(date -d today +"%Y%m%d")"
					timemachine="$(date -d "$sysdate" +"%Y%m%d")"
					if [ $today -ge $timemachine ]
					then
						echo ""
						tput setaf 7 ; tput setab 0 ; tput bold ;	echo "คุณป้อนวันที่ที่ผ่านมาหรือวันปัจจุบัน l!" ; echo "ป้อนอนาคตและวันที่ที่ถูกต้องในรูปแบบ วัน/เดือน/ปี" ; echo "ตัวอย่าง: 21/04/2023" ; tput sgr0
						echo ""
						exit 1
					else
						chage -E $sysdate $usuario
						echo ""
						tput setaf 7 ; tput setab 0 ; tput bold ; echo "ผู้ใช้งาน $usuario วันใช้งาน: $udata " ; tput sgr0
						echo ""
						exit 1
					fi
				else
					echo ""
					tput setaf 7 ; tput setab 0 ; tput bold ;	echo "คุณป้อนวันที่ที่ไม่ถูกต้องหรือไม่มีอยู่จริง !" ; echo "ป้อนวันที่ที่ถูกต้องในรูปแบบ วัน/เดือน/ปี" ; echo "ตัวอย่าง: 21/04/2023" ; tput sgr0
					echo ""
					exit 1
				fi
			fi
		else
			echo ""
			tput setaf 7 ; tput setab 0 ; tput bold ;	echo "คุณป้อนวันที่ที่ไม่ถูกต้องหรือไม่มีอยู่จริง !" ; echo "ป้อนวันที่ที่ถูกต้องในรูปแบบ วัน/เดือน/ปี" ; echo "ตัวอย่าง: 21/04/2023" ; tput sgr0
			echo ""
			exit 1
		fi
	else
		echo " "
		tput setaf 7 ; tput setab 0 ; tput bold ;	echo "ผู้ใช้งาน $usuario ไม่พบ !" ; tput sgr0
		echo " "
		exit 1
	fi
fi