#!/bin/bash
fun_bar () {
comando[0]="$1"
comando[1]="$2"
 (
[[ -e $HOME/fim ]] && rm $HOME/fim
${comando[0]} -y > /dev/null 2>&1
${comando[1]} -y > /dev/null 2>&1
touch $HOME/fim
 ) > /dev/null 2>&1 &
 tput civis
echo -ne "  \033[1;33mโปรดรอสักครู่ \033[1;37m- \033[1;33m["
while true; do
   for((i=0; i<18; i++)); do
   echo -ne "\033[1;36m━"
   sleep 0.1s
   done
   [[ -e $HOME/fim ]] && rm $HOME/fim && break
   echo -e "\033[1;33m]"
   sleep 1s
   tput cuu1
   tput dl1
   echo -ne "  \033[1;33mโปรดรอสักครู่ \033[1;37m- \033[1;33m["
done
echo -e "\033[1;33m]\033[1;37m -\033[1;32m ✓ เสร็จแล้ว\033[1;37m"
tput cnorm
}
clear
echo -e "\033[1;36m════════════════════════════════════════════════════\033[0m"
echo -e "\E[44;1;37m             🛠️ ออโต้สคริป โดย หลวงพี่ ✨              \E[0m"
echo -e "\033[1;36m════════════════════════════════════════════════════\033[0m"
echo -e "\033[0m"
echo -e "⚠️  โปรดทราบ"
echo ""
echo -e "เมื่อสิ้นสุดกระบวนการ คุณจะต้องกำหนดค่า      "
echo -e "บริการ SlowDNS อีกครั้ง เลือกตัวเลือก      "
echo -e "ใช้รหัสปัจจุบันเพื่อกู้คืนรหัสเก่าของคุณ     "
echo ""
read -r -p "↵ กด Enter เพื่อดำเนินการต่อ... " _
echo ""
echo -e "   \033[0;36m🧹 กำลังลบไฟล์เก่า...\033[0m"
echo ""
fun_remove () {
rm -rf remove-slow; wget -q https://raw.githubusercontent.com/savat/ocr-api/main/Install/remove-slow && chmod +x remove-slow && bash remove-slow
sleep 2
rm -rf /bin/slowdns && rm /root/remove-slow
sleep 2
rm remove-slow && rm -rf /etc/slowdns
}
fun_bar 'fun_remove'
rm -rf /etc/slowdns
echo ""
echo -e "   \033[0;36m🔄 กำลังอัปเดตสคริปต์...\033[0m"
echo ""
fun_update () {
rm -rf install && wget -q https://raw.githubusercontent.com/savat/ocr-api/main/Install/install && chmod +x install && bash install
}
fun_bar 'fun_update'
sleep 3
echo ""
echo -e "\033[0;36m✅ อัปเดต SlowDNS เรียบร้อยแล้ว\033[0m"
echo ""
sleep 3
echo -e "  \033[1;33mเปิดเมนูการใช้งาน: \033[1;37m\033sslowdns\033[1;33m"
echo ""
read -r -p "↵ กด Enter เพื่อกลับเมนู... " _
echo -e "\033[0m"
