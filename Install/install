#!/bin/bash
clear
fun_bar () {
comando[0]="$1"
comando[1]="$2"
 (
[[ -e $HOME/fim ]] && rm $HOME/fim
${comando[0]} -y > /dev/null 2>&1
${comando[1]} -y > /dev/null 2>&1
touch $HOME/fim
 ) > /dev/null 2>&1 &
 tput civis
 local _f=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧') _i=0
 while [[ ! -e $HOME/fim ]]; do
   printf '\r  \033[1;35m%s\033[0m \033[1;37mกำลังทำงาน\033[0m \033[0;90m…\033[0m' "${_f[_i++ % 8]}"
   sleep 0.12
 done
 rm -f $HOME/fim
 printf '\r\033[K  \033[1;32m✔\033[0m \033[1;37mเสร็จแล้ว\033[0m\n'
 tput cnorm
}
clear
echo -e "\E[45;1;37m ⚡ หลวงพี่ · AUTOSCRIPT\E[K\E[0m"
echo -e "\033[0;35m────────────────────────────────────\033[0m"
echo -e "\033[0m"
echo -e "📦 กำลังดาวน์โหลดและเตรียมแพ็กเกจ..."
echo ""
fun_att () {
apt install ncurses-utils -y
mkdir /etc/slowdns
cd /etc/slowdns
wget -q https://raw.githubusercontent.com/savat/ocr-api/main/Install/dns-server; chmod +x dns-server
wget -q https://raw.githubusercontent.com/leitura/slowdns/main/remove-slow; chmod +x remove-slow
wget -q https://raw.githubusercontent.com/leitura/slowdns/main/slowdns-info; chmod +x slowdns-info
wget -q https://raw.githubusercontent.com/leitura/slowdns/main/slowdns-drop; chmod +x slowdns-drop
wget -q https://raw.githubusercontent.com/leitura/slowdns/main/slowdns-ssh; chmod +x slowdns-ssh
wget -q https://raw.githubusercontent.com/leitura/slowdns/main/slowdns-ssl; chmod +x slowdns-ssl
wget -q https://raw.githubusercontent.com/leitura/slowdns/main/slowdns-socks; chmod +x slowdns-socks
wget -q https://raw.githubusercontent.com/leitura/slowdns/main/slowdns; chmod +x slowdns; cp slowdns /bin/
wget -q https://raw.githubusercontent.com/leitura/slowdns/main/stopdns; chmod +x stopdns
}
fun_bar 'fun_att'
echo -e "🛡️ กำลังตั้งค่า Firewall..."
echo ""
fun_ports () {
apt install firewalld -y && sudo firewall-cmd --zone=public --permanent --add-port=80/tcp && sudo firewall-cmd --zone=public --permanent --add-port=8080/tcp && sudo firewall-cmd --zone=public --permanent --add-port=443/tcp && sudo firewall-cmd && sudo firewall-cmd --zone=public --permanent --add-port=53/udp && sudo firewall-cmd --zone=public --permanent --add-port=5300/udp && sudo firewall-cmd && sudo firewall-cmd --zone=public --permanent --add-port=2222/tcp && sudo firewall-cmd --reload
}
fun_bar 'fun_ports'
echo -e "🌐 กำหนด DNS ของ Cloudflare..."
echo ""
fun_dnscf () {
sudo systemctl disable systemd-resolved.service && sudo systemctl stop systemd-resolved.service && sudo mv /etc/resolv.conf /etc/resolv.conf.bkp && echo "nameserver 1.1.1.1" > /etc/resolv.conf
sudo systemctl enable systemd-resolved.service && sudo systemctl start systemd-resolved.service
sleep 2
}
fun_bar 'fun_dnscf'
clear
echo -e "\E[45;1;37m ⚡ หลวงพี่ · AUTOSCRIPT\E[K\E[0m"
echo -e "\033[0;35m────────────────────────────────────\033[0m"
echo -e "\033[0m"
echo -e "🎉 ติดตั้งเรียบร้อยแล้ว! "
echo ""
echo -e "เปิดเมนูพิมพ์: \033[1;33mslowdns\033[0m"
cd
rm install
