#!/bin/bash
_lvk=$(wget -qO- https://raw.githubusercontent.com/savat/ocr-api/main/Install/version)
IP=$(wget -qO- http://whatismyip.akamai.com/)
IP2=$(wget -qO- http://whatismyip.akamai.com/)
[[ "$IP" != "$IP2" ]] && ipdovps="$IP2" || ipdovps="$IP"
echo -e "$ipdovps" >/etc/IP
lst=$1 && lst1=$2 && lst2=$3 && key1=$4 && key2=thvpn
echo -e "Asia/Bangkok" >/etc/timezone
ln -fs /usr/share/zoneinfo/Asia/Bangkok /etc/localtime >/dev/null 2>&1
dpkg-reconfigure --frontend noninteractive tzdata >/dev/null 2>&1

[[ -z $lst1 ]] && {
	rm -rf $_Ink/list >/dev/null 2>&1 && cat /dev/null >~/.bash_history && history -c && exit 0
}

[[ ! -d /etc/TH-VPN ]] && mkdir /etc/TH-VPN
[[ ! -d /etc/TH-VPN/senha ]] && mkdir /etc/TH-VPN/senha
[[ ! -e /etc/TH-VPN/Exp ]] && touch /etc/TH-VPN/Exp
[[ ! -d /etc/TH-VPN/userteste ]] && mkdir /etc/TH-VPN/userteste
[[ ! -d /etc/TH-VPN/.tmp ]] && mkdir /etc/TH-VPN/.tmp
[[ ! -d /etc/bot ]] && mkdir /etc/bot
[[ ! -d /etc/bot/info-users ]] && mkdir /etc/bot/info-users
[[ ! -d /etc/bot/arquivos ]] && mkdir /etc/bot/arquivos
[[ ! -d /etc/bot/revenda ]] && mkdir /etc/bot/revenda
[[ ! -d /etc/bot/suspensos ]] && mkdir /etc/bot/suspensos
[[ ! -e /etc/bot/lista_ativos ]] && touch /etc/bot/lista_ativos
[[ ! -e /etc/bot/lista_suspensos ]] && touch /etc/bot/lista_suspensos

echo -e 'by: @TH-VPN' >/usr/lib/TH-VPN 
cat /usr/lib/TH-VPN >$lst2/licence
cat /usr/lib/TH-VPN > /etc/TH-VPN/.tmp/thvpn
echo "/bin/menu" > /bin/thvpn && chmod +x /bin/thvpn
netstat -nplt | grep -w 'apache2' | grep -w '80' && sed -i "s/Listen 80/Listen 81/g" /etc/apache2/ports.conf
service apache2 restart
cp /etc/ssh/sshd_config /etc/ssh/sshd_back 
[[ "$(grep -o '#Port 22' /etc/ssh/sshd_config)" == "#Port 22" ]]
sed -i "s;#Port 22;Port 22;" /etc/ssh/sshd_config
service ssh restart
grep -v "^PasswordAuthentication" /etc/ssh/sshd_config >/tmp/passlogin
mv /tmp/passlogin /etc/ssh/sshd_config
echo "PasswordAuthentication yes" >>/etc/ssh/sshd_config

_dir1='/bin'
_dir2='/etc/TH-VPN'
rm $_dir2/ShellBot.sh $_dir2/cabecalho $_dir2/open.py $_dir2/proxy.py $_dir2/wsproxy.py >/dev/null 2>&1
_mdls=("addhost" "delhost" "alterarsenha" "criarusuario" "expcleaner" "mudardata" "remover" "criarteste" "verifbot" "droplimiter" "alterarlimite" "ajuda" "sshmonitor" "badvpn" "userbackup" "instsqd" "blockt" "otimizar" "menu" "ferramentascodes" "gestorcodes" "usercodes" "utilscodes" "monitores" "speedtest" "banner" "senharoot" "atualizarsistema" "reiniciarservicos" "reiniciarsistema" "attscript" "conexao" "delscript" "detalhes" "botssh" "infousers" "slow_dns" "verifatt" "limiter" "uexpired" "cabecalho" "bot" "tcpspeed" "open.py" "proxy.py" "wsproxy.py" "trojan-go" "onlineapp" "swapmemory" "v2raymanager" "apache2menu" "webminmenu" "vnc_inst" "shadowsocks_user" "initbot" "initcheck" "pkill.sh" "onlineapp" "swapmemory")
for _arq in ${_mdls[@]}; do
	[[ -e $_dir1/$_arq ]] && rm $_dir1/$_arq >/dev/null 2>&1
	wget -c -P $_dir1 https://raw.githubusercontent.com/savat/ocr-api/main/Modulos/$_arq
	chmod +x $_dir1/$_arq
done

mv $_dir1/cabecalho $_dir1/bot $_dir1/open.py $_dir1/proxy.py $_dir1/wsproxy.py $_dir2

_arq_host="/etc/hosts"
_host[0]="www.opensignal.com"
_host[1]="connect.facebook.net"
_host[2]="login.windows.net"
_host[3]="lan3rd.line.me"
_host[4]="cdn.beetalkapp.com"
_host[5]="speedtest.3bb.co.th"
_host[6]="speedtest.adslthailand.com"
_host[7]=".speedtest.net"
_host[8]="www.lazada.co.th"
_host[9]="app.dtac.co.th"
_host[10]="/TH-VPN?"
for host in ${_host[@]}; do
	if [[ "$(grep -w "$host" $_arq_host | wc -l)" = "0" ]]; then
		sed -i "3i\127.0.0.1 $host" $_arq_host
	fi
done

[[ ! -e /etc/autostart ]] && {
	echo '#!/bin/bash
clear
#AUTOMATIC START' >/etc/autostart
	chmod +x /etc/autostart
} || {
	[[ $(ps x | grep "bot_plus" | grep -v grep | wc -l) != '0' ]] && wget -qO- https://raw.githubusercontent.com/savat/ocr-api/main/Install/ShellBot.sh >/etc/TH-VPN/ShellBot.sh
	for proc in $(ps x | grep 'dmS' | grep -v 'grep' | awk {'print $1'}); do
		screen -r -S "$proc" -X quit
	done
	screen -wipe >/dev/null
	echo '#!/bin/bash
clear
#AUTOMATIC START' >/etc/autostart
	chmod +x /etc/autostart
}

crontab -r >/dev/null 2>&1
(
	crontab -l 2>/dev/null
	echo "@daily /bin/verifatt"
	echo "@reboot /etc/autostart"
	echo "* * * * * /etc/autostart"
	echo "0 */6 * * * /bin/uexpired"
) | crontab -

echo "$_lvk" | sed -n '1 p' | cut -d' ' -f2 >/bin/version && cat /bin/version >/home/TH-VPN
wget -q https://raw.githubusercontent.com/savat/ocr-api/main/Install/jq-linux64 >/dev/null 2>&1
chmod +x jq-linux64 && mv jq-linux64 $(which jq)
service cron restart >/dev/null 2>&1
service ssh restart >/dev/null 2>&1
[[ -d /var/www/html/openvpn ]] && service apache2 restart >/dev/null 2>&1
rm -rf $lst1/list >/dev/null 2>&1